    animation: s10FooterGradient 12s ease infinite;
    border-radius: 16px; position: relative; overflow: hidden;
    margin-top: 30px;
    margin-bottom: 40px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    opacity: 0; transform: translateY(20px);
    transition: all 1s cubic-bezier(0.22,1,0.36,1) 1.8s;
}
.s10-getstarted-section.revealed .s10-footer-cta { opacity: 1; transform: translateY(0); }

.s10-footer-cta::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(217,164,65,0.08) 0%, transparent 50%);
    pointer-events: none;
}

.s10-footer-left {
