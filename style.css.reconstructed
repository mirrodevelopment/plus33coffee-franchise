/* Card Mouse Spotlight */
.s10-action-card::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(300px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212,106,40,0.08), transparent 50%);
    z-index: 1; pointer-events: none; opacity: 0; transition: opacity 0.5s ease;
}
.s10-action-card:hover::before { opacity: 1; }

/* Cafe Wrapper Hover Effects */
.s10-cafe-bg-wrap:hover .s10-cafe-img {
    transform: scale(1.04);
    filter: brightness(1.05) contrast(1.02);
}
.s10-cafe-bg-wrap:hover .s10-cafe-warm-light {
    opacity: 1;
    background: radial-gradient(ellipse at 70% 30%, rgba(217,164,65,0.15) 0%, transparent 60%);
}

/* Custom Cursor inside Section 10 */
.s10-getstarted-section {
    cursor: none; /* Hide default cursor */
}

.s10-custom-cursor {
    position: absolute; width: 8px; height: 8px;
    background: #D46A28; border-radius: 50%;
    pointer-events: none; z-index: 1000;
    transform: translate(-50%, -50%);
    transition: width 0.2s ease, height 0.2s ease, background-color 0.2s ease;
    box-shadow: 0 0 10px rgba(212,106,40,0.6);
    opacity: 0;
}
.s10-cursor-glow {
    position: absolute; width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(217,164,65,0.08) 0%, transparent 70%);
    pointer-events: none; z-index: 2;
    transform: translate(-50%, -50%);
    opacity: 0; transition: opacity 0.5s ease;
}
.s10-getstarted-section:hover .s10-custom-cursor,
.s10-getstarted-section:hover .s10-cursor-glow {
    opacity: 1;
}
/* Custom cursor hover state */
.s10-custom-cursor.s10-cursor-hover {
    width: 24px; height: 24px;
    background: transparent;
    border: 1.5px solid #D46A28;
    box-shadow: 0 0 15px rgba(212,106,40,0.3);
}

/* Interactive Card Magnet Animation */
.s10-action-card {
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

/* Trail Particles */
.s10-trail-particle {
    position: absolute; width: 4px; height: 4px;
    background: #D46A28; border-radius: 50%;
    pointer-events: none; z-index: 999;
    box-shadow: 0 0 8px rgba(212,106,40,0.8);
    opacity: 1;
    transform: translate(-50%, -50%);
    animation: s10TrailFade 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}
@keyframes s10TrailFade {
    0% { transform: translate(-50%, -50%) scale(1) translateY(0); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(0.1) translateY(-20px); opacity: 0; }
}

/* Footer CTA Animated Gradient */
.s10-footer-cta {
    background: linear-gradient(135deg, #1B2A4A 0%, #0D1B30 50%, #1B2A4A 100%);
    background-size: 200% 200%;
    animation: s10FooterGradient 12s ease infinite;
}
@keyframes s10FooterGradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

/* ==========================================================================
   Categories Pop-up Modal (High-Fidelity Side-by-Side Design)
   ========================================================================== */
.category-modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(6, 27, 54, 0.75);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  z-index: 10000;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  padding: 20px;
}

.category-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.category-modal-container {
  display: flex;
  flex-direction: row;
  background: #F7F4EF; /* matching cream background on the right */
  border-radius: 24px;
  box-shadow: 0 30px 70px rgba(6, 27, 54, 0.4);
  width: 100%;
  max-width: 950px;
  height: 620px;
  position: relative;
  transform: scale(0.92);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.category-modal-overlay.active .category-modal-container {
  transform: scale(1);
}

/* Left Side: Image Block */
.modal-left-image-block {
  width: 42%;
  height: 100%;
  position: relative;
  overflow: hidden;
  background: var(--luxury-dark); /* default dark background for photos */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.4s ease;
}

.modal-left-image-block.product-layout {
  background: #EDE8DF; /* elegant cream background that blends with the phone app / coffee bag mockups */
}

.modal-left-img.photo-fit {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.modal-left-img.product-fit {
  width: auto;
  height: 80%;
  max-width: 80%;
  object-fit: contain;
  margin: auto;
  display: block;
  filter: drop-shadow(0 10px 25px rgba(0,0,0,0.12));
}

/* Dark overlay on left image - only active for photo layout */
.modal-left-image-block::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(6, 27, 54, 0.25) 0%, rgba(6, 27, 54, 0.55) 100%);
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.modal-left-image-block.product-layout::after {
  opacity: 0; /* disable dark overlay for product layout */
}

/* Pill badge on left image */
.modal-pill-badge {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  background: var(--deep-navy);
  border: 1px solid var(--primary-gold);
  color: var(--champagne-gold);
  border-radius: var(--radius-full);
  padding: 0.5rem 1.25rem;
  font-family: var(--font-sans);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  z-index: 10;
}

/* Right Side: Details Content */
.modal-right-content-block {
  width: 58%;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
}

.category-modal-close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: #FFFFFF;
  border: 1px solid rgba(163, 127, 67, 0.15);
  color: var(--deep-navy);
  cursor: pointer;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  z-index: 10;
}

.category-modal-close:hover {
  background: var(--primary-gold);
  color: var(--white);
  border-color: var(--primary-gold);
  transform: rotate(90deg);
}

.category-modal-close svg {
  width: 16px;
  height: 16px;
}

.modal-right-body {
  flex: 1;
  padding: 3rem 2.5rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.modal-card-title {
  font-family: var(--font-serif);
  font-size: 2.25rem;
  font-weight: 500;
  color: var(--deep-navy);
  margin: 0;
