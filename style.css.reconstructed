.ben-center {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.hex-wheel-wrapper {
  position: relative;
  width: 420px;
  height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-style: preserve-3d;
  perspective: 1000px;
}

/* Ambient Glow */
.hex-ambient-glow {
  position: absolute;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 165, 74, 0.15) 0%, rgba(7, 29, 58, 0.05) 50%, transparent 70%);
  animation: hexGlowPulse 4s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}
@keyframes hexGlowPulse {
  0%, 100% { transform: scale(0.95); opacity: 0.7; }
  50% { transform: scale(1.05); opacity: 1.1; }
}

/* 3D Hex Image Container */
.hex-img-3d {
  position: relative;
  width: 360px;
  height: 360px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  /* Premium 3D drop-shadow around the transparent PNG wheel */
  filter: drop-shadow(0 20px 40px rgba(7, 29, 58, 0.25)) 
          drop-shadow(0 4px 15px rgba(212, 165, 74, 0.15));
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  transform-style: preserve-3d;
}

.hex-main-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}

.hex-wheel-wrapper:hover .hex-img-3d {
  transform: translateY(-10px) rotateX(6deg) rotateY(-6deg);
}

/* Connector Pointers (Dot + Line) */
.hex-pointer {
  position: absolute;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
}

.ptr-dot {
  position: relative;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #D4A54A;
  border: 2px solid #F8F4EE;
  box-shadow: 0 0 10px rgba(212, 165, 74, 0.8);
  cursor: pointer;
  z-index: 2;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ptr-dot::after {
  content: '';
  position: absolute;
  top: -6px;
  left: -6px;
  right: -6px;
  bottom: -6px;
  border-radius: 50%;
  border: 1px solid rgba(212, 165, 74, 0.6);
  animation: ptrDotPulse 2s infinite;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.hex-pointer:hover .ptr-dot::after,
.hex-pointer.active .ptr-dot::after {
  opacity: 1;
}

.hex-pointer:hover .ptr-dot,
.hex-pointer.active .ptr-dot {
  background: #071D3A;
  border-color: #D4A54A;
  transform: scale(1.3);
  box-shadow: 0 0 15px rgba(212, 165, 74, 1);
}

@keyframes ptrDotPulse {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(1.6); opacity: 0; }
}

.ptr-line {
  position: absolute;
  height: 1px;
  border-top: 1.5px dashed rgba(212, 165, 74, 0.45);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  opacity: 0.7;
}

.ptr-line-left {
  right: 12px;
  transform-origin: right center;
}

.ptr-line-right {
  left: 12px;
  transform-origin: left center;
}

/* Active line animation/highlight */
.hex-pointer.active .ptr-line {
  border-top-style: solid;
  border-top-color: #D4A54A;
  opacity: 1;
}

/* Precise Positions on the Hex Image */
/* Left Side Pointers */
.hex-ptr-l1 {
  top: 100px;
  left: 100px;
}
.hex-ptr-l1 .ptr-line-left {
  width: 100px;
  transform: rotate(12deg);
}

