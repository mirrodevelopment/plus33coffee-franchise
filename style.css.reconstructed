    font-weight: 700;
    color: #D9A441;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -30%);
}

.s10-footer-brand {
    display: flex; flex-direction: column;
}
.s10-footer-brand-name {
    font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: #FFF;
    letter-spacing: 0.5px;
}
.s10-footer-brand-sub {
    font-family: 'Outfit', sans-serif; font-size: 0.6rem; font-weight: 600;
