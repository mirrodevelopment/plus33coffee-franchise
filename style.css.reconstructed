    position: relative;
    perspective: 1200px;
}
.s6-store-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    animation: storeFloat 6s infinite ease-in-out;
    transform-style: preserve-3d;
}
@keyframes storeFloat {
    0%, 100% { transform: translateY(0) rotateX(2deg) rotateY(-2deg); }
    50% { transform: translateY(-12px) rotateX(0deg) rotateY(0deg); }
}
.s6-base-glow {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) rotateX(70deg);
    width: 80%;
    height: 120px;
    background: radial-gradient(ellipse, rgba(212, 165, 74, 0.4) 0%, transparent 70%);
    filter: blur(15px);
    pointer-events: none;
    z-index: 1;
}
.s6-floating-ring {
    position: absolute;
    bottom: 40px;
    left: 50%;
    width: 110%;
    height: 160px;
    transform: translateX(-50%) rotateX(75deg);
    border: 1px dashed rgba(212, 165, 74, 0.4);
    border-radius: 50%;
    animation: ringRotate 20s linear infinite;
    z-index: 1;
    pointer-events: none;
}
.s6-floating-ring.ring-inner {
    width: 90%;
    height: 130px;
    bottom: 55px;
    border: 1px solid rgba(212, 165, 74, 0.2);
    box-shadow: 0 0 10px rgba(212, 165, 74, 0.2);
    animation: ringRotateRev 15s linear infinite;
}
@keyframes ringRotate {
    0% { transform: translateX(-50%) rotateX(75deg) rotateZ(0deg); }
    100% { transform: translateX(-50%) rotateX(75deg) rotateZ(360deg); }
}
@keyframes ringRotateRev {
    0% { transform: translateX(-50%) rotateX(75deg) rotateZ(360deg); }
    100% { transform: translateX(-50%) rotateX(75deg) rotateZ(0deg); }
}

.s6-store-image-container {
    position: relative;
    z-index: 5;
    width: 100%;
}
.s6-store-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.15));
    transition: filter 0.4s ease;
}
.s6-store-wrapper:hover .s6-store-img {
    filter: drop-shadow(0 40px 50px rgba(212, 165, 74, 0.2));
}

/* Connectors Overlay */
.s6-connectors-svg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 4;
    pointer-events: none;
    overflow: visible;
}
.s6-line {
    fill: none;
    stroke: rgba(212, 165, 74, 0.4);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    transition: stroke 0.3s ease;
}
.s6-line.active {
    stroke: #D4A54A;
    stroke-width: 2;
    animation: dashMove 1s linear infinite;
}
@keyframes dashMove {
    to { stroke-dashoffset: -8; }
}
.s6-node {
    fill: #FAF8F5;
    stroke: rgba(212, 165, 74, 0.6);
    stroke-width: 2;
    transition: all 0.3s ease;
}
.s6-node.active {
    fill: #D4A54A;
    stroke: #fff;
    r: 6;
    filter: drop-shadow(0 0 5px #D4A54A);
}

/* Callouts Right Side */
.s6-callouts {
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
}
.s6-callout-item {
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    transition: transform 0.3s ease;
    padding: 10px;
    border-radius: 8px;
}
.s6-callout-item:hover, .s6-callout-item.active {
    transform: translateX(-10px);
    background: rgba(255,255,255,0.4);
}
.s6-callout-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(212, 165, 74, 0.3);
    color: #D4A54A;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
}
.s6-callout-item:hover .s6-callout-icon, .s6-callout-item.active .s6-callout-icon {
    background: #D4A54A;
    color: #fff;
    box-shadow: 0 0 15px rgba(212, 165, 74, 0.4);
}
.s6-callout-icon svg { width: 18px; height: 18px; }
.s6-callout-text h6 {
    font-size: 0.8rem;
    font-weight: 700;
    color: #071D3A;
    margin: 0 0 4px;
}
.s6-callout-text p {
    font-size: 0.75rem;
    color: #5C6E82;
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
}
.s6-callout-item:hover .s6-callout-text p, .s6-callout-item.active .s6-callout-text p {
    color: #071D3A;
}

/* Custom Hover Colors for Section 6 Callouts & Connectors */
.s6-callout-item[data-target="1"]:hover, .s6-callout-item[data-target="1"].active {
    background: rgba(212, 165, 74, 0.08) !important;
}
.s6-callout-item[data-target="1"]:hover .s6-callout-icon, .s6-callout-item[data-target="1"].active .s6-callout-icon {
    background: #D4A54A !important;
    border-color: #D4A54A !important;
    box-shadow: 0 0 15px rgba(212, 165, 74, 0.4) !important;
}

.s6-callout-item[data-target="2"]:hover, .s6-callout-item[data-target="2"].active {
    background: rgba(226, 138, 92, 0.08) !important;
}
.s6-callout-item[data-target="2"]:hover .s6-callout-icon, .s6-callout-item[data-target="2"].active .s6-callout-icon {
    background: #E28A5C !important;
    border-color: #E28A5C !important;
    box-shadow: 0 0 15px rgba(226, 138, 92, 0.4) !important;
}

.s6-callout-item[data-target="3"]:hover, .s6-callout-item[data-target="3"].active {
    background: rgba(156, 109, 80, 0.08) !important;
}
.s6-callout-item[data-target="3"]:hover .s6-callout-icon, .s6-callout-item[data-target="3"].active .s6-callout-icon {
    background: #9C6D50 !important;
    border-color: #9C6D50 !important;
    box-shadow: 0 0 15px rgba(156, 109, 80, 0.4) !important;
}

.s6-callout-item[data-target="4"]:hover, .s6-callout-item[data-target="4"].active {
    background: rgba(109, 78, 116, 0.08) !important;
}
.s6-callout-item[data-target="4"]:hover .s6-callout-icon, .s6-callout-item[data-target="4"].active .s6-callout-icon {
    background: #6D4E74 !important;
    border-color: #6D4E74 !important;
    box-shadow: 0 0 15px rgba(109, 78, 116, 0.4) !important;
}

.s6-callout-item[data-target="5"]:hover, .s6-callout-item[data-target="5"].active {
    background: rgba(31, 78, 121, 0.08) !important;
}
.s6-callout-item[data-target="5"]:hover .s6-callout-icon, .s6-callout-item[data-target="5"].active .s6-callout-icon {
    background: #1F4E79 !important;
    border-color: #1F4E79 !important;
    box-shadow: 0 0 15px rgba(31, 78, 121, 0.4) !important;
}

/* Active connector lines matching target colors */
.s6-line-1.active { stroke: #D4A54A !important; }
.s6-line-2.active { stroke: #E28A5C !important; }
.s6-line-3.active { stroke: #9C6D50 !important; }
.s6-line-4.active { stroke: #6D4E74 !important; }
.s6-line-5.active { stroke: #1F4E79 !important; }

/* Active node points matching target colors */
.s6-node-1.active { fill: #D4A54A !important; stroke: #fff !important; filter: drop-shadow(0 0 5px #D4A54A) !important; }
.s6-node-2.active { fill: #E28A5C !important; stroke: #fff !important; filter: drop-shadow(0 0 5px #E28A5C) !important; }
.s6-node-3.active { fill: #9C6D50 !important; stroke: #fff !important; filter: drop-shadow(0 0 5px #9C6D50) !important; }
.s6-node-4.active { fill: #6D4E74 !important; stroke: #fff !important; filter: drop-shadow(0 0 5px #6D4E74) !important; }
.s6-node-5.active { fill: #1F4E79 !important; stroke: #fff !important; filter: drop-shadow(0 0 5px #1F4E79) !important; }

/* Far Right Formats Stack */
.s6-far-right-col {
    display: flex;
    flex-direction: column;
}
.s6-formats-header {
    margin-bottom: 20px;
}
.s6-formats-header h6 {
    font-size: 0.85rem;
    font-weight: 700;
    color: #071D3A;
    margin: 0;
    line-height: 1.4;
}
.s6-format-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.s6-format-card {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 165, 74, 0.25);
    border-radius: 12px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
    cursor: pointer;
}
.s6-format-cards:hover .s6-format-card:not(:hover) {
    opacity: 0.6;
    transform: scale(0.98);
}
.s6-format-card:hover {
    transform: translateY(-5px);
    border-color: rgba(212, 165, 74, 0.6);
    box-shadow: 0 15px 35px rgba(212, 165, 74, 0.1);
    background: rgba(255, 255, 255, 0.9);
}
.s6-format-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}
.s6-format-top .s6-format-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(212, 165, 74, 0.1);
    color: #D4A54A;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(212, 165, 74, 0.3);
}
.s6-format-top .s6-format-icon svg { width: 16px; height: 16px; }
.s6-format-top h6 {
    font-size: 0.85rem;
    font-weight: 700;
    color: #071D3A;
    margin: 0;
}
.s6-format-img-wrap {
    width: 100%;
    height: 80px;
    border-radius: 8px;
    background: #f0f0f0;
    margin-bottom: 12px;
    overflow: hidden;
}
.s6-format-img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
}
.s6-format-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 8px;
}
.s6-format-list li {
    font-size: 0.7rem;
    color: #4A5B6F;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.3;
}
.s6-format-list li svg {
    width: 14px; height: 14px; color: #D4A54A; flex-shrink: 0;
}

/* Bottom Divider */
.s6-bottom-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
}
.s6-bottom-divider::before, .s6-bottom-divider::after {
    content: '';
    height: 1px;
    flex-grow: 1;
    background: linear-gradient(90deg, transparent, rgba(212, 165, 74, 0.4), transparent);
}
.s6-bottom-divider h6 {
    font-size: 0.85rem;
    font-weight: 700;
    color: #071D3A;
    letter-spacing: 0.05em;
    margin: 0;
}
.s6-bottom-divider .diamond {
    width: 6px; height: 6px; background: #D4A54A; transform: rotate(45deg);
}

/* Bottom Features Strip */
.s6-bottom-features {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 165, 74, 0.2);
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 40px;
}
.s6-feature-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease;
}
.s6-feature-item:hover {
    transform: translateY(-5px);
}
.s6-feature-icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: rgba(212, 165, 74, 0.1);
    color: #D4A54A;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(212, 165, 74, 0.3);
    margin-bottom: 16px;
    transition: all 0.3s ease;
}
.s6-feature-item:hover .s6-feature-icon {
    background: #D4A54A;
    color: #fff;
    box-shadow: 0 0 15px rgba(212, 165, 74, 0.4);
    transform: scale(1.1);
}
.s6-feature-icon svg { width: 22px; height: 22px; }
.s6-feature-item h6 {
    font-size: 0.75rem;
    font-weight: 700;
    color: #071D3A;
    margin: 0 0 8px;
    transition: color 0.3s ease;
}
.s6-feature-item:hover h6 {
    color: #D4A54A;
}
.s6-feature-item p {
    font-size: 0.7rem;
    color: #5C6E82;
    margin: 0;
    line-height: 1.4;
}

/* CTA Bar */
.s6-cta-bar {
    background: linear-gradient(135deg, #071D3A 0%, #0F2D54 100%);
    border-radius: 100px;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 20px 40px rgba(7, 29, 58, 0.2);
    position: relative;
    overflow: hidden;
}
.s6-cta-bar::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 165, 74, 0.15) 0%, transparent 60%);
    pointer-events: none;
}
.s6-cta-left {
    display: flex;
    align-items: center;
    gap: 24px;
}
.s6-cta-crown {
    width: 64px; height: 64px;
    border-radius: 50%;
    border: 1px solid rgba(212, 165, 74, 0.4);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: #D4A54A;
}
.s6-cta-crown svg { width: 24px; height: 24px; margin-bottom: 2px; }
.s6-cta-crown span { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; line-height: 1; }
.s6-cta-text h6 {
    font-size: 0.95rem; font-weight: 700; color: #D4A54A; margin: 0 0 4px;
}
.s6-cta-text p {
    font-size: 0.85rem; color: #fff; margin: 0;
}
.s6-btn-download {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, #D4A54A 0%, #A37F43 100%);
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.s6-btn-download svg { width: 18px; height: 18px; }
.s6-btn-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(212, 165, 74, 0.4);
}
.btn-glow-shimmer {
    position: absolute;
    top: 0; left: -100%;
    width: 50%; height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent);
    transform: skewX(-20deg);
    animation: shimmerLoop 3s infinite;
}
@keyframes shimmerLoop {
    0% { left: -100%; }
    20% { left: 200%; }
    100% { left: 200%; }
}

/* Responsiveness */
@media (max-width: 1400px) {
    .s6-top-row { grid-template-columns: 240px 1fr 240px 260px; gap: 20px; }
}
@media (max-width: 1200px) {
    .s6-top-row { grid-template-columns: 1fr 1fr; grid-template-areas: "left center" "formats callouts"; gap: 40px; }
    .s6-left-col { grid-area: left; }
    .s6-center-col { grid-area: center; }
    .s6-right-col { grid-area: callouts; }
    .s6-far-right-col { grid-area: formats; }
    .s6-connectors-svg { display: none; } /* Hide SVG lines on tablet/mobile */
    .s6-bottom-features { flex-wrap: wrap; }
    .s6-feature-item { flex: 1 1 30%; }
}
@media (max-width: 992px) {
    .s6-top-row { grid-template-columns: 1fr; grid-template-areas: "left" "center" "callouts" "formats"; }
    .s6-cta-bar { flex-direction: column; text-align: center; border-radius: 24px; gap: 24px; padding: 30px; }
    .s6-cta-left { flex-direction: column; }
}
@media (max-width: 768px) {
    .s6-feature-item { flex: 1 1 45%; }
}

/* Hotspots Overlaying Store Image */
.s6-hotspot {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: background 0.4s ease;
    z-index: 10;
}
/* Approximate positions on the store image */
.hotspot-1 { top: 20%; left: 50%; }
.hotspot-2 { top: 40%; left: 30%; }
.hotspot-3 { top: 60%; left: 70%; }
.hotspot-4 { top: 80%; left: 40%; }
.hotspot-5 { top: 85%; left: 60%; }
/* ==========================================================================
   SECTION 07: INVESTMENT HIGHLIGHTS
   ========================================================================== */
.investment-highlights-section {
    position: relative;
    padding: 120px 0 100px;
    background: #F8F5EE; /* Cream background matching reference */
    overflow: hidden;
    color: #061B36; /* Navy */
}

/* --- Atmospheric Elements --- */
.s7-ambient-spotlight {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.08) 0%, transparent 60%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
}

.s7-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
}

.s7-particle-spark {
    position: absolute;
    background: #D9A441;
    border-radius: 50%;
    box-shadow: 0 0 10px #D9A441, 0 0 20px rgba(217, 164, 65, 0.5);
    opacity: 0;
}

@keyframes s7ParticleDrift {
    0% { transform: translateY(0) scale(0.8); opacity: 0; }
    20% { opacity: 0.6; }
    50% { transform: translateY(-50px) scale(1.2); opacity: 0.8; }
    80% { opacity: 0.4; }
    100% { transform: translateY(-100px) scale(0.8); opacity: 0; }
}

/* --- Container & Layout --- */
.s7-container {
    position: relative;
    max-width: 1350px;
    margin: 0 auto;
    padding: 0 40px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* --- Header Section --- */
.s7-header {
    text-align: center;
    width: 100%;
    margin-bottom: 60px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.investment-highlights-section.revealed .s7-header {
    opacity: 1;
    transform: translateY(0);
}

.s7-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #D9A441; /* Gold */
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.s7-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 3.8vw, 4.2rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
    text-align: center;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap !important;
    flex-wrap: nowrap !important;
}

.s7-heading .word {
    display: inline-block;
    font-weight: 800;
}

.s7-heading .orange-line {
    color: #D46A28; /* Burnt Orange */
}

.s7-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 25px;
}

.s7-divider .divider-line {
    width: 60px;
    height: 1px;
    background: rgba(217, 164, 65, 0.4);
}

.s7-divider .divider-icon {
    color: #D9A441;
    font-size: 1.2rem;
}

.s7-description {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #2F4156;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
}

/* --- Timeline Interactive Area --- */
.s7-timeline-area {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    position: relative;
    min-height: 600px;
    margin-bottom: 60px;
}

.s7-cards-col {
    display: flex;
    flex-direction: column;
    gap: 60px;
    width: 300px;
    z-index: 10;
}

.s7-cards-left {
    align-items: flex-end;
    text-align: right;
    padding-top: 150px;
}

.s7-cards-right {
    align-items: flex-start;
    text-align: left;
    padding-top: 50px;
}

/* --- Ribbon Center --- */
.s7-center-ribbon-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 450px;
    height: 700px;
    z-index: 5;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transform: translate(-50%, -30px) scale(0.95);
    transition: all 1.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
}

.investment-highlights-section.revealed .s7-center-ribbon-wrap {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    animation: s7RibbonBreathe 8s ease-in-out infinite alternate 1.8s;
}

@keyframes s7RibbonBreathe {
    0% { transform: translate(-50%, -50%) scale(1); }
    100% { transform: translate(-50%, -55%) scale(1.02); }
}

.s7-ribbon-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 10;
    filter: drop-shadow(0 20px 40px rgba(212, 106, 40, 0.15));
}

/* --- Orbit Rings --- */
.s7-orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px dashed rgba(217, 164, 65, 0.3);
    transform: translate(-50%, -50%) rotateX(70deg);
    z-index: 1;
    box-shadow: 0 0 30px rgba(217, 164, 65, 0.1) inset;
}

.s7-orbit-ring::after {
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    width: 6px;
    height: 6px;
    background: #FFF;
    border-radius: 50%;
    box-shadow: 0 0 10px #D9A441, 0 0 20px #FFF;
}

.s7-orbit-ring.ring-1 {
    width: 600px;
    height: 600px;
    animation: s7RingRotate 30s linear infinite;
}

.s7-orbit-ring.ring-2 {
    width: 450px;
    height: 450px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: s7RingRotate 20s linear infinite reverse;
}

@keyframes s7RingRotate {
    0% { transform: translate(-50%, -50%) rotateX(70deg) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotateX(70deg) rotate(360deg); }
}

/* --- Info Cards --- */
.s7-info-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: default;
    position: relative;
}

.s7-card-left {
    flex-direction: row-reverse;
}

.investment-highlights-section.revealed .s7-info-card {
    opacity: 1;
    transform: translateY(0);
}

/* Staggered entry */
.investment-highlights-section.revealed .s7-card-left:nth-child(1) { transition-delay: 0.6s; }
.investment-highlights-section.revealed .s7-card-right:nth-child(1) { transition-delay: 0.8s; }
.investment-highlights-section.revealed .s7-card-left:nth-child(2) { transition-delay: 1.0s; }
.investment-highlights-section.revealed .s7-card-right:nth-child(2) { transition-delay: 1.2s; }
.investment-highlights-section.revealed .s7-card-right:nth-child(3) { transition-delay: 1.4s; }

.s7-card-icon-wrap {
    position: relative;
    width: 65px;
    height: 65px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 10px 25px rgba(0,0,0,0.05), inset 0 2px 5px rgba(255,255,255,0.8);
    backdrop-filter: blur(5px);
    transition: all 0.4s ease;
    z-index: 2;
}

.s7-card-icon-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.4) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
}

.s7-card-svg {
    width: 28px;
    height: 28px;
    z-index: 3;
    transition: transform 0.4s ease;
}

.s7-card-svg.purple { color: #8A648C; }
.s7-card-svg.orange { color: #D46A28; }
.s7-card-svg.gold { color: #D9A441; }
.s7-card-svg.slate { color: #51657A; }

.s7-card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.s7-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.3;
}

.s7-card-title.purple-text { color: #8A648C; }
.s7-card-title.orange-text { color: #D46A28; }
.s7-card-title.slate-text { color: #51657A; }

.s7-card-desc {
    font-size: 0.9rem;
    color: #4A5B6D;
    line-height: 1.5;
}

/* Hover Effects */
.s7-info-card:hover {
    transform: translateY(-5px);
}

.s7-info-card:hover .s7-card-icon-wrap {
    background: rgba(255, 255, 255, 0.9);
    border-color: #D9A441;
    box-shadow: 0 15px 35px rgba(217, 164, 65, 0.2), inset 0 2px 5px rgba(255,255,255,1);
}

.s7-info-card:hover .s7-card-icon-glow {
    opacity: 1;
    transform: scale(1.5);
}

.s7-info-card:hover .s7-card-svg {
    transform: scale(1.1);
}

/* --- Ribbon Hotspots --- */
.s7-ribbon-hotspot {
    position: absolute;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(217, 164, 65, 0.4) 40%, transparent 70%);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
    transition: all 0.4s ease;
    pointer-events: none;
    z-index: 15;
    mix-blend-mode: overlay;
}

.s7-ribbon-hotspot.active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.5);
    box-shadow: 0 0 30px #FFF, 0 0 50px #D9A441;
}

/* Approximate positions on the ribbon image */
.spot-1 { top: 20%; left: 60%; }
.spot-2 { top: 38%; left: 35%; }
.spot-3 { top: 58%; left: 65%; }
.spot-4 { top: 76%; left: 35%; }
.spot-5 { top: 92%; left: 60%; }


/* --- Bottom KPI Bar --- */
.s7-kpi-bar-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    opacity: 0;
    transform: translateY(40px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 1.6s;
    margin-top: 20px;
}

.investment-highlights-section.revealed .s7-kpi-bar-wrapper {
    opacity: 1;
    transform: translateY(0);
}

.s7-kpi-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 16px;
    padding: 35px 30px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    position: relative;
    overflow: hidden;
}

.s7-kpi-bar::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(217, 164, 65, 0.5), transparent);
}

.s7-kpi-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    flex: 1;
    padding: 0 15px;
    position: relative;
    transition: transform 0.4s ease;
}

.s7-kpi-block:hover {
    transform: translateY(-5px);
}

.s7-kpi-icon {
    color: #D46A28;
    width: 32px;
    height: 32px;
    margin-bottom: 5px;
    transition: all 0.4s ease;
    filter: drop-shadow(0 4px 6px rgba(212, 106, 40, 0.2));
}

.s7-kpi-block:hover .s7-kpi-icon {
    transform: scale(1.1);
    color: #D9A441;
}

.s7-kpi-value {
    font-family: var(--font-sans);
    font-size: 2.2rem;
    font-weight: 700;
    color: #061B36;
    line-height: 1;
}

.s7-kpi-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: #4A5B6D;
    line-height: 1.4;
}

.s7-kpi-divider {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, rgba(217, 164, 65, 0.3), transparent);
}


/* --- Responsive Design --- */
@media (max-width: 1100px) {
    .s7-timeline-area {
        flex-direction: column;
        gap: 80px;
        min-height: auto;
    }

    .s7-center-ribbon-wrap {
        position: relative;
        transform: none !important;
        top: auto; left: auto;
        margin: 0 auto;
    }

    .s7-cards-col {
        width: 100%;
        padding-top: 0;
        align-items: center;
        text-align: center;
    }

    .s7-card-left {
        flex-direction: column;
    }

    .s7-card-right {
        flex-direction: column;
    }

    .s7-kpi-bar {
        flex-wrap: wrap;
        gap: 30px;
        padding: 30px;
    }

    .s7-kpi-block {
        flex: 0 0 45%;
    }

    .s7-kpi-divider {
        display: none;
    }
}

@media (max-width: 768px) {
    .investment-highlights-section {
        padding: 80px 0;
    }

    .s7-heading {
        font-size: 2.5rem;
    }

    .s7-center-ribbon-wrap {
        width: 100%;
        max-width: 350px;
        height: auto;
    }

    .s7-kpi-block {
        flex: 0 0 100%;
    }
}
/* ==========================================================================
   SECTION 08: FRANCHISE JOURNEY
   ========================================================================== */
.franchise-journey-section {
    position: relative;
    padding: 120px 0 100px;
    background: #F8F5EE; /* Cream background */
    overflow: hidden;
    color: #061B36; /* Navy */
    z-index: 10;
}

/* --- Atmospheric Elements --- */
.s8-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.05) 0%, transparent 60%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
}

.s8-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
}

.s8-particle {
    position: absolute;
    background: #D9A441;
    border-radius: 50%;
    box-shadow: 0 0 10px #D9A441, 0 0 20px rgba(217, 164, 65, 0.5);
    opacity: 0;
}

@keyframes s8ParticleFloat {
    0% { transform: translateY(0) scale(0.8); opacity: 0; }
    20% { opacity: 0.8; }
    50% { transform: translateY(-80px) scale(1.2); opacity: 1; }
    80% { opacity: 0.6; }
    100% { transform: translateY(-150px) scale(0.8); opacity: 0; }
}

/* --- Container & Layout --- */
.s8-container {
    position: relative;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* --- Header Section --- */
.s8-header {
    text-align: center;
    width: 100%;
    margin-bottom: 30px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.franchise-journey-section.revealed .s8-header {
    opacity: 1;
    transform: translateY(0);
}

.s8-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #D46A28; /* Burnt Orange */
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.s8-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 3.8vw, 4.2rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
    text-align: center;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap !important;
    flex-wrap: nowrap !important;
}

.s8-heading .word {
    display: inline-block;
    font-weight: 800;
}

.s8-heading .orange-line {
    color: #D46A28; 
}

.s8-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 20px;
}

.s8-divider .divider-line {
    width: 60px;
    height: 1px;
    background: rgba(217, 164, 65, 0.4);
}

.s8-divider .divider-icon {
    color: #D9A441;
    font-size: 1.2rem;
}

.s8-description {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #2F4156;
    max-width: 800px;
    margin: 0 auto 20px auto;
    text-align: center;
}

/* --- Promise Card (Centered top-center) --- */
.s8-promise-card {
    position: relative;
    top: auto;
    left: auto;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(217, 164, 65, 0.3);
    border-radius: 12px;
    padding: 20px;
    width: 320px;
    max-width: 90%;
    display: flex;
    gap: 15px;
    box-shadow: 0 15px 35px rgba(217, 164, 65, 0.08), inset 0 2px 10px rgba(255,255,255,1);
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 0.6s;
    z-index: 10;
    margin: 10px auto 0 auto;
    text-align: left;
}

.franchise-journey-section.revealed .s8-promise-card {
    opacity: 1;
    transform: translateY(0);
}

.s8-promise-card .promise-icon {
    color: #D9A441;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

.s8-promise-card h6 {
    font-size: 0.75rem;
    color: #D46A28;
    letter-spacing: 1.5px;
    margin-bottom: 5px;
    font-weight: 700;
}

.s8-promise-card p {
    font-size: 0.85rem;
    color: #4A5B6D;
    line-height: 1.4;
    margin: 0;
}

/* --- Central Timeline Asset Wrapper --- */
.s8-timeline-wrapper {
    position: relative;
    width: 100%;
    max-width: 1400px;
    height: 480px;
    margin: 60px auto 80px;
    opacity: 0;
    transform: translateY(45px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
    z-index: 5;
}

.franchise-journey-section.revealed .s8-timeline-wrapper {
    opacity: 1;
    transform: translateY(0);
}

.s8-timeline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
}

.s8-path-bg {
    stroke-dasharray: none;
    stroke-dashoffset: 0;
}

.s8-path-active {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    transition: stroke-dashoffset 3.2s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
}

.franchise-journey-section.revealed .s8-path-active {
    stroke-dashoffset: 0;
}

.s8-path-flow {
    stroke-dasharray: 60, 240;
    stroke-dashoffset: 2000;
    animation: s8FlowTravel 8s linear infinite;
}

@keyframes s8FlowTravel {
    0% { stroke-dashoffset: 2000; }
    100% { stroke-dashoffset: 0; }
}

.s8-hotspot {
    position: absolute;
    width: 76px;
    height: 76px;
    z-index: 10;
    transform: translate(-50%, -50%);
    cursor: pointer;
}

.s8-node-circle {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #FFFFFF;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    opacity: 0;
    transform: scale(0.5);
    
    /* Golden metallic border ring */
    box-shadow: 0 4px 15px rgba(184, 138, 74, 0.12),
                inset 0 0 0 3px #FAF8F5,
                0 0 0 3px #D1A66A;
}

.franchise-journey-section.revealed .s8-node-circle {
    opacity: 1;
    transform: scale(1);
}

.s8-circle-inner {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #FFFFFF;
    border: 2px solid var(--step-color);
    color: var(--step-color);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.s8-circle-inner svg {
    width: 24px;
    height: 24px;
    stroke-width: 1.5;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.4s ease;
}

/* Hover effects */
.s8-hotspot:hover .s8-node-circle {
    transform: scale(1.12);
    box-shadow: 0 12px 32px var(--step-color-glow),
                inset 0 0 0 3px #FAF8F5,
                0 0 0 3.5px #B88A4A;
}

.s8-hotspot:hover .s8-circle-inner {
    background: var(--step-color);
    color: #FFFFFF;
    border-color: var(--step-color);
    box-shadow: 0 0 15px var(--step-color-glow);
}

.s8-hotspot:hover .s8-circle-inner svg {
    transform: scale(1.15) rotate(5deg);
}

.s8-hotspot:hover .s8-step-text h6 {
    color: var(--step-color);
}

.s8-step-text {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    text-align: center;
    pointer-events: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
}

.s8-step-number {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--step-color);
    line-height: 1.1;
    margin-bottom: 6px;
}

.s8-step-text h6 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
    text-transform: uppercase;
    transition: color 0.3s ease;
}

.s8-step-text p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    color: #475569;
    line-height: 1.4;
    margin: 0;
}

/* Staggered step fades in revealed state */
.franchise-journey-section.revealed .s8-step-text {
    opacity: 1;
}

.step-below .s8-step-text {
    top: calc(50% + 54px);
    transform: translate(-50%, 20px);
}
.franchise-journey-section.revealed .step-below .s8-step-text {
    transform: translate(-50%, 0);
}

.step-above .s8-step-text {
    bottom: calc(50% + 54px);
    transform: translate(-50%, -20px);
}
.franchise-journey-section.revealed .step-above .s8-step-text {
    transform: translate(-50%, 0);
}

/* Stagger delays */
.franchise-journey-section.revealed .s8-hotspot[data-step="1"] .s8-node-circle { transition-delay: 0.1s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="1"] .s8-step-text { transition-delay: 0.15s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="2"] .s8-node-circle { transition-delay: 0.25s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="2"] .s8-step-text { transition-delay: 0.3s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="3"] .s8-node-circle { transition-delay: 0.4s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="3"] .s8-step-text { transition-delay: 0.45s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="4"] .s8-node-circle { transition-delay: 0.55s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="4"] .s8-step-text { transition-delay: 0.6s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="5"] .s8-node-circle { transition-delay: 0.7s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="5"] .s8-step-text { transition-delay: 0.75s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="6"] .s8-node-circle { transition-delay: 0.85s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="6"] .s8-step-text { transition-delay: 0.9s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="7"] .s8-node-circle { transition-delay: 1.0s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="7"] .s8-step-text { transition-delay: 1.05s; }

.franchise-journey-section.revealed .s8-hotspot[data-step="8"] .s8-node-circle { transition-delay: 1.15s; }
.franchise-journey-section.revealed .s8-hotspot[data-step="8"] .s8-step-text { transition-delay: 1.2s; }

/* --- Bottom Dashboard Cards --- */
.s8-dashboard-wrapper {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 15px;
    opacity: 0;
    transform: translateY(40px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 1.4s;
}

.franchise-journey-section.revealed .s8-dashboard-wrapper {
    opacity: 1;
    transform: translateY(0);
}

.s8-dash-card {
    flex: 1;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(217, 164, 65, 0.2);
    border-radius: 12px;
    padding: 25px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
}

.s8-dash-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(217,164,65,0.05) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
}

/* Dashboard Card Hover Effects */
.s8-dash-card:hover {
    transform: translateY(-10px);
    border-color: #D9A441;
    box-shadow: 0 20px 40px rgba(217, 164, 65, 0.15), inset 0 2px 10px rgba(255,255,255,1);
}

.s8-dash-card:hover::before {
    opacity: 1;
}

.dash-icon {
    color: #D46A28;
