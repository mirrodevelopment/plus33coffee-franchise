  height: 10px;
  border-radius: var(--radius-full);
  border: 1px solid var(--white);
}

.bev-color { background-color: var(--rev-navy); }
.bak-color { background-color: var(--rev-gold); }
.des-color { background-color: var(--rev-orange); }
.loy-color { background-color: var(--rev-teal); }
