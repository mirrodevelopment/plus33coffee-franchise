/* ==========================================================================
   Bottom Category Showcase & Profitability Section
   ========================================================================== */
/* Container Scroll Reveal */
.showcase-profit-container {
  width: 100%;
  max-width: 1440px;
  margin: 6rem auto 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  position: relative;
  z-index: 3;
  
  /* Initial hidden state for scroll reveal observer */
  opacity: 0;
  transform: translateY(40px);
  filter: blur(10px);
  transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
              transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
              filter 1.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.revenue-section.revealed .showcase-profit-container {
  opacity: 1;
  transform: translateY(0);
  filter: blur(0);
}

/* 1. Main Category Panel (Luxury Glassmorphism) */
.category-showcase-panel {
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(212, 165, 74, 0.25);
  border-radius: 32px;
  padding: 3rem 2rem 2.5rem 2rem;
  box-shadow: 
    inset 0 1px 0 rgba(255, 255, 255, 0.7),
    0 20px 60px rgba(0, 0, 0, 0.08),
    0 0 40px rgba(212, 165, 74, 0.12);
  position: relative;
  transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  overflow: hidden;
}

.category-showcase-panel:hover {
  transform: translateY(-10px);
  box-shadow: 
    inset 0 1px 0 rgba(255, 255, 255, 0.8),
    0 30px 80px rgba(0, 0, 0, 0.12),
    0 0 50px rgba(212, 165, 74, 0.18);
}

/* Mouse-Following Spotlight (Category Panel) */
.category-showcase-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 32px;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 165, 74, 0.08) 0%, transparent 60%);
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.category-showcase-panel:hover::before {
  opacity: 1;
}

/* Rolls-Royce Golden Light Ribbon Sweep */
.gold-light-ribbon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 250px;
  height: 250px;
  background: radial-gradient(circle at 100% 100%, rgba(212, 165, 74, 0.18) 0%, transparent 70%);
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
  border-bottom-right-radius: 32px;
}

.gold-light-ribbon::before {
  content: '';
  position: absolute;
  width: 150%;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(212, 165, 74, 0.6), transparent);
  bottom: 50px;
  right: -50px;
  transform: rotate(-45deg);
  animation: luxurySweep 8s ease-in-out infinite;
  box-shadow: 0 0 15px rgba(212, 165, 74, 0.4);
}

.gold-light-ribbon::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 6px;
  background: #D4A54A;
  border-radius: 50%;
  bottom: 80px;
  right: 120px;
  opacity: 0;
  box-shadow: 0 0 10px #D4A54A;
  animation: ribbonSparkle 4s ease-in-out infinite;
}

@keyframes luxurySweep {
  0%, 100% {
    transform: translate(0, 0) rotate(-45deg);
    opacity: 0.4;
  }
  50% {
    transform: translate(-30px, -30px) rotate(-45deg);
    opacity: 0.95;
  }
}

@keyframes ribbonSparkle {
  0%, 100% { opacity: 0; transform: translateY(0); }
  50% { opacity: 0.8; transform: translateY(-15px) scale(1.2); }
}

.showcase-title {
  font-family: var(--font-serif);
