  align-items: center;
  gap: 0.875rem;
  width: 180px;
  cursor: pointer;
  z-index: 10;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.floating-cat-card:hover,
.floating-cat-card.active {
  transform: translateY(-5px);
  border-color: var(--rev-gold);
  background: var(--white);
  box-shadow: 0 15px 35px rgba(217, 164, 65, 0.15);
}

.cat-card-badge-mini {
