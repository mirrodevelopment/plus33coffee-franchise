/* ==========================================================================
   PLUS33 CAFÉ FRANÇAIS - PREMIUM LUXURY HERO SECTION STYLESHEET
   Style: Royal, Cinematic, Investor-focused (Rolex / Rolls-Royce level)
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700;1,800;1,900&family=Inter:wght@300;400;500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Allura&display=swap');

:root {
  /* Color Palette */
  --primary-gold: #B88A4A;
  --champagne-gold: #D1A66A;
  --cta-orange: #E86A2A;
  --cta-orange-hover: #C9561C;
  --deep-navy: #10253A;
  --luxury-dark: #0D2235;
  --storefront-black: #16181D;
  --heading: #121826;
  --body-text: #5B6470;
  --secondary-text: #707A87;
  --premium-ivory: #F8F6F3;
  --soft-cream: #F3EFEA;
  --card-bg: #FAF8F5;
  --white: #FFFFFF;

  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Outfit', 'Sora', sans-serif;

  /* Spacing & Borders */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
  --transition-smooth: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-cinematic: 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==========================================================================
   1. Reset & Global Styles
   ========================================================================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background: linear-gradient(180deg, var(--white) 0%, var(--premium-ivory) 100%);
  color: var(--body-text);
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
}

/* Subtle Parisian café blur in background */
.bg-pattern-blur {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  background-image: radial-gradient(circle at 10% 20%, rgba(243, 239, 234, 0.6) 0%, transparent 50%),
                    radial-gradient(circle at 90% 80%, rgba(217, 166, 106, 0.05) 0%, transparent 60%);
  z-index: 0;
  pointer-events: none;
}

/* ==========================================================================
   2. Header & Navigation
   ========================================================================== */
.header-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100px;
  z-index: 100;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(184, 138, 74, 0.08);
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(-40px);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
}

body.loaded .header-nav {
  opacity: 1;
  transform: translateY(0);
}

.nav-container {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 4rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  transition: transform var(--transition-smooth);
}

.logo-link:hover {
  transform: scale(1.02);
}

.logo-icon {
  height: 68px;
  width: auto;
  display: block;
}

.logo-text {
  font-family: var(--font-sans);
  font-size: 2.25rem;
  font-weight: 700;
  color: var(--heading);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  line-height: 1;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 2.25rem;
}

.nav-item {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--heading);
  text-decoration: none;
  position: relative;
  padding: 0.5rem 0;
  transition: color 0.3s ease;
}

.nav-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1.5px;
  background: var(--primary-gold);
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-item:hover {
  color: var(--primary-gold);
}

.nav-item:hover::after {
  width: 100%;
}

.nav-right {
  display: flex;
  align-items: center;
}

.btn-deck {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  background: linear-gradient(135deg, #F07A36 0%, var(--cta-orange) 100%);
  color: var(--white);
  padding: 0.875rem 1.625rem;
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(232, 106, 42, 0.2);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-deck:hover {
  background: linear-gradient(135deg, var(--cta-orange) 0%, var(--cta-orange-hover) 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(232, 106, 42, 0.35);
}

.icon-download {
  transition: transform 0.3s ease;
}

.btn-deck:hover .icon-download {
  transform: translateY(2px);
}

.mobile-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.mobile-toggle .bar {
  display: block;
  width: 24px;
  height: 2px;
  margin: 5px auto;
  background-color: var(--heading);
  transition: all 0.3s ease-in-out;
}

/* ==========================================================================
   3. Hero Section General Layout
   ========================================================================== */
.hero-section {
  min-height: 100vh;
  padding-top: 100px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 10;
}

.hero-container {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 2.5rem 4rem 0 4rem;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 4rem;
}

/* ==========================================================================
   4. Left Content Block
   ========================================================================== */
.hero-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.eyebrow {
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--primary-gold);
  margin-bottom: 1.5rem;
  opacity: 0;
  transform: translateY(15px);
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 0.2s;
}

body.loaded .eyebrow {
  opacity: 1;
  transform: translateY(0);
}

.main-heading {
  font-family: var(--font-serif);
  font-size: 5rem;
  font-weight: 800;
  line-height: 1.1;
  color: var(--heading);
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.main-heading .line {
  display: block;
  overflow: hidden;
  position: relative;
}

.main-heading .line::after {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 0;
  color: var(--heading);
}

/* Line-by-line reveal logic */
.main-heading .line {
  opacity: 0;
  transform: translateY(30px);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
}

body.loaded .main-heading .line:nth-child(1) {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.4s;
}

body.loaded .main-heading .line:nth-child(2) {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.6s;
}

.sub-heading {
  font-family: var(--font-serif);
  font-size: 3.5rem;
  font-weight: 400;
  font-style: italic;
  margin-bottom: 2rem;
  position: relative;
  display: inline-block;
  
  /* Shimmer text effect config */
  background: linear-gradient(
    90deg,
    #B88A4A 0%,
    #D1A66A 25%,
    #FFF0D4 50%,
    #D1A66A 75%,
    #B88A4A 100%
  );
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  
  opacity: 0;
  transform: translateY(20px);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 0.8s;
}

body.loaded .sub-heading {
  opacity: 1;
  transform: translateY(0);
  animation: shimmer 5s linear infinite;
}

@keyframes shimmer {
  0% {
    background-position: 0% center;
  }
  100% {
    background-position: 200% center;
  .page-cup-wrapper {
    position: relative !important;
    width: 150px !important;
    height: 140px !important;
    margin: 0 auto 10px auto !important;
  }

  /* Override absolute positioning of the coffee cup loader inside the book pages */
  .s8-book .s8-css-cup-loader {
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 50% !important;
    transform: translateX(-50%) scale(0.68) !important;
    transform-origin: top center !important;
    width: 150px !important;
    height: 200px !important;
    z-index: 3 !important;
    pointer-events: none !important;
  }
}

.description {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--body-text);
  max-width: 520px;
  margin-bottom: 3rem;
  opacity: 0;
  transform: translateY(20px);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 1s;
}

body.loaded .description {
  opacity: 1;
  transform: translateY(0);
}

.cta-group {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  opacity: 0;
  transform: translateY(20px);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 1.2s;
}

body.loaded .cta-group {
  opacity: 1;
  transform: translateY(0);
}

/* Primary Orange Button */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: linear-gradient(135deg, #F07A36 0%, var(--cta-orange) 100%);
  color: var(--white);
  padding: 1.125rem 2.25rem;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(232, 106, 42, 0.25);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1px solid transparent;
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--cta-orange) 0%, var(--cta-orange-hover) 100%);
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(232, 106, 42, 0.4);
}

.arrow-icon {
  transition: transform 0.3s ease;
}

.btn-primary:hover .arrow-icon {
  transform: translateX(4px);
}

/* Secondary Outline Button */
.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: transparent;
  color: var(--heading);
  padding: 1.125rem 2.25rem;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  border: 1px solid rgba(18, 24, 38, 0.2);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-secondary:hover {
  border-color: var(--heading);
  background: rgba(18, 24, 38, 0.02);
  transform: translateY(-3px);
}

.btn-secondary:hover .arrow-icon {
  transform: translateX(4px);
}

/* ==========================================================================
   5. Right Visual block (Storefront & Stats Card)
   ========================================================================== */
.hero-visual {
  position: relative;
  width: 100%;
  max-width: 680px;
  margin-left: -3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.96) translateX(30px);
  transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 0.3s;
}

body.loaded .hero-visual {
  opacity: 1;
  transform: scale(1) translateX(0);
}

.storefront-wrapper {
  width: 100%;
  height: 520px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  position: relative;
  border: 1px solid rgba(184, 138, 74, 0.15);
}

.storefront-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform: scale(1.08);
  transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.storefront-wrapper:hover .storefront-img {
  transform: scale(1.02);
}

/* Soft Warm Light Overlay to mimic French interior lighting */
.storefront-glass-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 60% 70%, rgba(209, 166, 106, 0.15) 0%, transparent 60%),
              linear-gradient(to top, rgba(16, 37, 58, 0.1) 0%, transparent 100%);
  pointer-events: none;
}

/* Floating Dark Glass Stats Card */
.stats-card {
  position: absolute;
  right: -100px;
  bottom: -30px;
  top: auto;
  width: 220px;
  background: linear-gradient(135deg, rgba(16, 37, 58, 0.95) 0%, rgba(13, 34, 53, 0.95) 100%);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-xl);
  padding: 1.25rem 1rem;
  box-shadow: 0 0 18px rgba(200, 155, 71, 0.35), 0 25px 50px rgba(13, 34, 53, 0.25);
  border: 1.5px solid #C89B47; /* Glowing gold border */
  z-index: 20;
  opacity: 0;
  overflow: hidden; /* Clip traveling edge glow */
  transition: transform var(--transition-cinematic), opacity var(--transition-cinematic), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  transition-delay: 0.8s;
}

/* Spotlight Hover Effect for Stats Card (follows mouse) */
.stats-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 165, 74, 0.15) 0%, transparent 60%);
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.5s ease;
}
.stats-card:hover::before {
  opacity: 1;
}

body.loaded .stats-card {
  opacity: 1;
  animation: floatCard 6s ease-in-out infinite, revealCard 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
}

@keyframes floatCard {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes revealCard {
  0% {
    opacity: 0;
    margin-right: -20px;
  }
  100% {
    opacity: 1;
    margin-right: 0;
  }
}

.stats-title {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0.12em;
  color: var(--champagne-gold);
  margin-bottom: 0.85rem;
  text-transform: uppercase;
  text-align: center;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  width: fit-content;
  margin: 0 auto;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  opacity: 0;
  transform: translateX(15px);
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

body.loaded .stat-item:nth-child(1) { opacity: 1; transform: translateX(0); transition-delay: 1.1s; }
body.loaded .stat-item:nth-child(2) { opacity: 1; transform: translateX(0); transition-delay: 1.3s; }
body.loaded .stat-item:nth-child(3) { opacity: 1; transform: translateX(0); transition-delay: 1.5s; }
body.loaded .stat-item:nth-child(4) { opacity: 1; transform: translateX(0); transition-delay: 1.7s; }

.stat-icon-wrapper {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-full);
  border: 1.5px solid #C89B47; /* Glowing gold border */
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--champagne-gold);
  background: rgba(184, 138, 74, 0.05);
  box-shadow: 0 0 8px rgba(200, 155, 71, 0.25); /* Subtle gold glow */
  transition: all 0.3s ease;
}

.stat-item:hover .stat-icon-wrapper {
  color: var(--white);
  background: var(--primary-gold);
  border-color: var(--primary-gold);
  box-shadow: 0 0 10px rgba(184, 138, 74, 0.4);
  transform: scale(1.05);
}

.stat-icon {
  width: 13px;
  height: 13px;
}

.stat-text {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1.2;
}

.stat-label {
  font-size: 0.5rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.3;
  margin-top: 1px;
}

/* ==========================================================================
   6. Bottom Metrics Bar
   ========================================================================== */
.metrics-bar-wrapper {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 4rem;
  position: relative;
  margin-top: 4rem;
  margin-bottom: 5rem;
  z-index: 30;
  opacity: 0;
  transform: translateY(30px);
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: 1.4s;
}

body.loaded .metrics-bar-wrapper {
  opacity: 1;
  transform: translateY(0);
}

.metrics-bar {
  background: rgba(248, 244, 238, 0.65); /* Warm light ivory tray background */
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24px;
  border: 1.5px solid rgba(217, 164, 65, 0.15); /* Light gold border around the tray */
  box-shadow: 0 20px 45px rgba(6, 27, 54, 0.04);
  padding: 3.5rem 2rem 2.5rem 2rem; /* Symmetrical padding with space for overlapping badges */
  display: flex;
  justify-content: space-between;
  align-items: center; /* Symmetrical horizontal alignment */
  gap: 1.5rem;
}

.metric-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 1px solid rgba(184, 138, 74, 0.15);
  padding: 2rem 1.25rem 1.75rem 1.25rem;
  position: relative;
  box-shadow: 0 8px 30px rgba(6, 27, 54, 0.03);
  opacity: 0;
  transform: translateY(20px);
  height: 240px; /* Reduced uniform height for all cards */
  justify-content: center;
}

/* Ensure all nested elements transition smoothly together */
.metric-block,
.metric-block * {
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

body.loaded .metric-block:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 1.6s; }
body.loaded .metric-block:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 1.8s; }
body.loaded .metric-block:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 2.0s; }
body.loaded .metric-block:nth-child(4) { opacity: 1; transform: translateY(0); transition-delay: 2.2s; }
body.loaded .metric-block:nth-child(5) { opacity: 1; transform: translateY(0); transition-delay: 2.4s; }

/* ----------------------------------------------------
   HOVER STATE: Turn into premium dark navy card
   ---------------------------------------------------- */
.metric-block:hover {
  background: linear-gradient(180deg, #061B36 0%, #030F1F 100%);
  border-color: var(--rev-gold);
  transform: translateY(-12px) scale(1.02);
  box-shadow: 0 20px 45px rgba(217, 164, 65, 0.25), inset 0 0 15px rgba(217, 164, 65, 0.15);
  z-index: 15;
}

.metric-card-badge {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 50px;
  height: 50px;
  border-radius: var(--radius-full);
  background: var(--white);
  border: 1px solid rgba(217, 164, 65, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(6, 27, 54, 0.05);
  z-index: 10;
}

/* Badge hover state */
.metric-block:hover .metric-card-badge {
  background: var(--rev-navy);
  border: 2px solid var(--rev-gold);
  box-shadow: 0 0 15px rgba(217, 164, 65, 0.4);
  width: 54px;
  height: 54px;
}

.metric-card-svg {
  width: 20px;
  height: 20px;
  color: var(--rev-gold);
}

/* SVG icon hover state */
.metric-block:hover .metric-card-badge .metric-card-svg {
  color: var(--rev-gold);
  transform: scale(1.1);
}

.metric-card-num {
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--rev-gold);
  margin-top: 0.5rem;
  margin-bottom: 0.35rem;
  opacity: 0.7;
}

/* Number text hover state */
.metric-block:hover .metric-card-num {
  opacity: 1;
}

.metric-block .metric-eyebrow {
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--secondary-text);
  margin-bottom: 0.5rem;
  text-transform: uppercase;
}

/* Eyebrow hover state */
.metric-block:hover .metric-eyebrow {
  color: rgba(255, 255, 255, 0.85);
}

.metric-card-divider {
  width: 30px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(217, 164, 65, 0.5), transparent);
  margin: 0.25rem 0 0.75rem 0;
}

/* Divider hover state */
.metric-block:hover .metric-card-divider {
  background: linear-gradient(90deg, transparent, var(--rev-gold), transparent);
}

.metric-block .metric-value {
  font-family: var(--font-sans);
  font-size: 1.45rem;
  font-weight: 600;
  color: var(--rev-navy);
  margin-bottom: 0.5rem;
  line-height: 1.2;
}

/* Metric Value hover state */
.metric-block:hover .metric-value {
  color: var(--rev-gold);
  font-weight: 700;
  text-shadow: 0 2px 10px rgba(217, 164, 65, 0.2);
}

.metric-block .metric-subtext {
  font-size: 0.5625rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--secondary-text);
  text-transform: uppercase;
}

/* Subtext hover state */
.metric-block:hover .metric-subtext {
  color: rgba(255, 255, 255, 0.6);
}

.metric-card-accent {
  display: flex;
  align-items: center;
  gap: 4px;
  width: 60px;
  margin-top: 1rem;
}

.metric-card-accent::before {
  content: '';
  flex: 1;
  height: 2px;
  background: var(--rev-gold);
  border-radius: var(--radius-full);
  opacity: 0.6;
}

.metric-card-accent::after {
  content: '• •';
  font-size: 7px;
  color: var(--rev-gold);
  letter-spacing: 1px;
  line-height: 1;
  opacity: 0.6;
}

/* Accent hover state */
.metric-block:hover .metric-card-accent::before {
  background: var(--rev-gold);
  opacity: 1;
}

.metric-block:hover .metric-card-accent::after {
  color: var(--rev-gold);
  opacity: 1;
}

.metric-card-badge {
  position: relative;
}

.metric-card-badge .badge-char {
  position: absolute;
  font-size: 10px;
  font-weight: 800;
  color: var(--rev-gold);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -40%);
}

/* ==========================================================================
   Mobile-Only Hero Image (Hidden by default on desktop)
   ========================================================================== */
.mobile-hero-image-wrapper {
  display: none;
}

.mobile-brand-quote-card {
  display: none;
}

