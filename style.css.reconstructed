/* ==============================================================
   TRUST BAR (GLASS BANNER CONTAINER)
   ============================================================== */
.s10-trust-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 36px; margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(217,164,65,0.15);
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03), 0 0 15px rgba(217, 164, 65, 0.04);
    opacity: 0; transform: translateY(30px);
    transition: all 1.2s cubic-bezier(0.22,1,0.36,1) 1.5s;
}
.s10-getstarted-section.revealed .s10-trust-bar { opacity: 1; transform: translateY(0); }

.s10-trust-item {
    display: flex; align-items: center; gap: 12px; flex: 1;
    transition: all 0.3s ease; padding: 6px 12px; border-radius: 8px;
}
.s10-trust-item:hover {
    transform: translateY(-3px);
    background: rgba(217,164,65,0.05);
}
.s10-trust-icon {
    width: 38px; height: 38px; flex-shrink: 0;
    border-radius: 50%; border: 1.5px solid rgba(212,106,40,0.25);
    display: flex; align-items: center; justify-content: center; padding: 7px;
    background: rgba(255,255,255,0.8);
    transition: all 0.3s ease;
}
.s10-trust-icon svg { width: 100%; height: 100%; }
.s10-trust-item:hover .s10-trust-icon {
    border-color: #D46A28; box-shadow: 0 0 15px rgba(212,106,40,0.2);
    transform: scale(1.08);
}
.s10-trust-text span {
    display: block; font-family: 'Outfit', sans-serif; font-size: 0.68rem;
    color: #1B2A4A; font-weight: 700; letter-spacing: 0.5px;
}
.s10-trust-text strong {
    font-family: 'Outfit', sans-serif; font-size: 0.75rem;
    color: #D46A28; font-weight: 800; letter-spacing: 0.5px;
}
.s10-trust-divider {
    width: 1px; height: 0; flex-shrink: 0;
    background: linear-gradient(to bottom, transparent, rgba(217,164,65,0.3), transparent);
    transition: height 1.2s cubic-bezier(0.22,1,0.36,1) 1.8s;
}
.s10-getstarted-section.revealed .s10-trust-divider { height: 40px; }

/* ==============================================================
   FOOTER CTA (ROUNDED NAVY CAPSULE)
   ============================================================== */
.s10-footer-cta {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px;
