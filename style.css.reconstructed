    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #EA580C;
    margin: 0;
}

.s9-time-btn-badge {
    background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
    color: #FFFFFF;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 5px 12px;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.28);
    transition: all 0.3s ease;
}

a.s9-time-card.s9-time-btn:hover .s9-time-btn-badge {
    background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
    box-shadow: 0 6px 16px rgba(249, 115, 22, 0.4);
}

a.s9-time-card.s9-time-btn:hover .s9-time-btn-badge svg {
    transform: translateX(3px);
}

/* Soft Radial Glow Behind Heading */
.faq-radial-glow {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, rgba(248, 244, 236, 0) 70%);
    pointer-events: none;
    z-index: 1;
}

.faq-container {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

/* Header */
.faq-header {
    text-align: center;
    margin-bottom: 48px;
}

.faq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
}

.faq-eyebrow-line {
    width: 32px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, #F97316, transparent);
}

.faq-eyebrow-text {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 5px;
    color: #EA580C;
    text-transform: uppercase;
}

.faq-main-heading {
    margin: 0 0 12px 0;
    line-height: 1.1;
}

.faq-heading-black {
    font-family: 'Playfair Display', 'Cormorant Garamond', serif;
    font-size: clamp(36px, 4.2vw, 56px);
    font-weight: 800;
    color: #020D1A;
    letter-spacing: -0.5px;
}

.faq-heading-gold-italic {
    font-family: 'Playfair Display', 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(38px, 4.4vw, 58px);
    font-weight: 800;
    background: linear-gradient(135deg, #F97316 0%, #EA580C 50%, #C2410C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    margin-left: 8px;
    letter-spacing: -0.5px;
}

.faq-subtitle {
    font-size: clamp(14px, 1.3vw, 17px);
    color: #4F4A43;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.45;
    font-weight: 500;
}

/* Main Grid Layout */
.faq-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 28px;
    margin-bottom: 44px;
}

@media (max-width: 1200px) {
    .faq-grid {
        grid-template-columns: 1fr;
    }
}

/* Left Column */
.faq-left-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* Expanded Card 01 */
.faq-expanded-card {
    position: relative;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(184, 134, 11, 0.18);
    border-radius: 20px;
    padding: 22px 28px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 130px;
    box-sizing: border-box;
    transition: all 0.3s ease;
}

.faq-expanded-card:hover {
    border-color: rgba(184, 134, 11, 0.35);
    box-shadow: 0 12px 32px rgba(184, 134, 11, 0.1);
}

.faq-expanded-content {
    flex: 1;
}

.faq-expanded-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
}

.faq-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 700;
    color: #B8860B;
}

.faq-num-divider {
    color: rgba(184, 134, 11, 0.4);
    font-size: 18px;
    font-weight: 300;
}

.faq-expanded-question {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1F1C18;
    margin: 0;
}

.faq-expanded-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(184, 134, 11, 0.2), transparent);
    margin-bottom: 8px;
}

.faq-expanded-answer {
    font-size: 13.5px;
    line-height: 1.45;
    color: #4F4A43;
    margin: 0;
}

.faq-expanded-visual {
    position: relative;
    width: 140px;
    height: 90px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
    background: #020D1A;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
}

.faq-coffee-cup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
}

.faq-expanded-card:hover .faq-coffee-cup-img {
    transform: scale(1.06);
}

.faq-visual-blur-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(2, 13, 26, 0.4) 100%);
}

.faq-toggle-btn {
    position: absolute;
    top: 14px;
    right: 16px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(184, 134, 11, 0.3);
    background: rgba(255, 255, 255, 0.8);
    color: #B8860B;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
}

.faq-toggle-btn:hover {
    background: #B8860B;
    color: #FFFFFF;
    transform: rotate(180deg);
}

/* Accordion Grid */
.faq-accordion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

@media (max-width: 768px) {
    .faq-accordion-grid {
        grid-template-columns: 1fr;
    }
}

.faq-accordion-subcol {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.faq-accordion-item {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(184, 134, 11, 0.2);
    border-radius: 14px;
    padding: 14px 20px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    cursor: pointer;
}

.faq-accordion-item:hover {
    transform: translateY(-2px);
    border-color: #B8860B;
    box-shadow: 0 8px 20px rgba(184, 134, 11, 0.1);
    background: rgba(255, 255, 255, 0.9);
}

.faq-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.faq-accordion-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
}

.faq-accordion-question {
    font-size: 14px;
    font-weight: 700;
    color: #1F1C18;
    margin: 0;
}

.faq-accordion-toggle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid rgba(184, 134, 11, 0.3);
    background: transparent;
    color: #B8860B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.faq-accordion-item:hover .faq-accordion-toggle {
    background: #B8860B;
    color: #FFF;
    border-color: #B8860B;
    transform: rotate(90deg);
}

.faq-accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding-top 0.3s ease;
}

.faq-accordion-item.active .faq-accordion-body {
    max-height: 120px;
    padding-top: 8px;
}

.faq-accordion-answer {
    font-size: 12.5px;
    line-height: 1.45;
    color: #4F4A43;
    margin: 0;
    border-top: 1px solid rgba(184, 134, 11, 0.12);
    padding-top: 8px;
}

/* Right Column - Contact Card */
.faq-right-col {
    height: 100%;
}

.faq-contact-card {
    position: relative;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(184, 134, 11, 0.2);
    border-radius: 16px;
    padding: 20px 20px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    box-sizing: border-box;
    justify-content: space-between;
}

.faq-contact-logo-wrap {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #020D1A;
    border: 1.5px solid #B8860B;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-sizing: border-box;
    margin-bottom: 4px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.faq-contact-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
}

.faq-contact-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    color: #1F1C18;
    line-height: 1.1;
    margin: 0 0 2px 0;
}

.faq-contact-divider {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.faq-divider-line {
    width: 16px;
    height: 1px;
    background: rgba(184, 134, 11, 0.3);
}

.faq-divider-diamond {
    font-size: 6px;
    color: #B8860B;
}

.faq-contact-desc {
    font-size: 11.5px;
    color: #4F4A43;
    line-height: 1.3;
    margin: 0 0 8px 0;
}

.faq-contact-info-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
}

.faq-contact-info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(184, 134, 11, 0.15);
    border-radius: 10px;
    padding: 6px 10px;
    text-align: left;
}

.faq-contact-icon-wrap {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(184, 134, 11, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.faq-contact-text-wrap {
    display: flex;
    flex-direction: column;
}

.faq-contact-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #B8860B;
    text-transform: uppercase;
}

.faq-contact-val {
    font-size: 11.5px;
    font-weight: 700;
    color: #1F1C18;
    text-decoration: none;
}

.faq-contact-cta {
    width: 100%;
    background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 9px 14px;
    border-radius: 40px;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.25);
    transition: all 0.3s ease;
    box-sizing: border-box;
}

.faq-contact-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(249, 115, 22, 0.4);
    background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
}

/* Bottom Promotional Banner */
.faq-promo-banner {
    position: relative;
    background: url('Images/faqseccardbg.png') center/cover no-repeat;
    border: 1px solid rgba(184, 134, 11, 0.45);
    border-radius: 20px;
    padding: 32px 40px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    min-height: 160px;
    box-sizing: border-box;
    overflow: hidden;
}

.faq-promo-center {
    text-align: center;
    z-index: 2;
    max-width: 680px;
    margin: 0 auto;
}

.faq-promo-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 5px;
    color: #D4AF37;
    display: block;
    margin-bottom: 8px;
    text-transform: uppercase;
}

.faq-promo-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.faq-promo-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 8px;
}

.faq-promo-line {
    width: 30px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.6), transparent);
}

.faq-promo-diamond {
    font-size: 7px;
    color: #D4AF37;
}

.faq-promo-subtitle {
    font-size: 14px;
    color: #D0C8B8;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
}

/* Responsive Media Queries */
@media (max-width: 1024px) {
    .faq-luxury-section {
        padding: 40px 24px;
    }
    
    .faq-promo-banner {
        background: url('Images/faqseccardbgmobile.png') center/cover no-repeat;
        flex-direction: column;
        text-align: center;
        padding: 24px 20px;
        min-height: 180px;
    }
}

@media (max-width: 768px) {
    .faq-promo-banner {
        background: url('Images/faqseccardbgmobile.png') center/cover no-repeat;
        padding: 20px 12px;
        min-height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .faq-promo-center {
        max-width: 54%;
        margin: 0 auto;
        padding: 0 2px;
    }

    .faq-promo-eyebrow {
        font-size: 8.5px;
        letter-spacing: 1.8px;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    .faq-promo-heading {
        font-size: 17px;
        line-height: 1.25;
        margin-bottom: 4px;
    }

    .faq-promo-divider {
        margin-bottom: 4px;
    }

    .faq-promo-line {
        width: 18px;
    }

    .faq-promo-subtitle {
        font-size: 10.5px;
        line-height: 1.3;
    }
}

@media (max-width: 480px) {
    .faq-luxury-section {
        padding: 30px 16px 60px 16px;
    }

    .faq-promo-banner {
        padding: 16px 6px;
        min-height: 145px;
    }

    .faq-promo-center {
        max-width: 52%;
    }

    .faq-promo-eyebrow {
        font-size: 7.8px;
        letter-spacing: 1.4px;
    }

    .faq-promo-heading {
        font-size: 14.5px;
    }

    .faq-promo-subtitle {
        font-size: 9.5px;
    }
}
