/* ====================================================================
   SECTION 10: LET'S GET STARTED — ULTRA LUXURY CONVERSION SECTION
   ==================================================================== */

.s10-getstarted-section {
    position: relative;
    background: linear-gradient(180deg, #FAF8F5 0%, #F5F1EA 50%, #FAF8F5 100%);
    padding: 120px 0 60px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}
.s10-getstarted-section.revealed { opacity: 1; }

/* Ambient */
.s10-ambient-glow {
    position: absolute; top: 20%; left: 40%; width: 700px; height: 500px;
    background: radial-gradient(ellipse, rgba(217,164,65,0.07) 0%, transparent 70%);
    transform: translateX(-50%); pointer-events: none; z-index: 0;
    animation: s10AmbientPulse 10s ease-in-out infinite alternate;
}
@keyframes s10AmbientPulse {
    0% { opacity: 0.4; transform: translateX(-50%) scale(1); }
    100% { opacity: 1; transform: translateX(-50%) scale(1.2); }
}
.s10-spotlight {
    position: absolute; top: -60px; left: 50%; width: 600px; height: 350px;
    background: radial-gradient(ellipse at center top, rgba(217,164,65,0.1) 0%, transparent 70%);
    transform: translateX(-50%); pointer-events: none; z-index: 0;
    opacity: 0; transition: opacity 2s ease 0.5s;
}
.s10-getstarted-section.revealed .s10-spotlight { opacity: 1; }

.s10-particles { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
.s10-particle-dot {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle, rgba(217,164,65,0.5) 0%, transparent 70%);
    pointer-events: none;
}
@keyframes s10ParticleDrift {
    0%, 100% { transform: translate(0,0) scale(1); opacity: 0.2; }
    50% { transform: translate(20px,-30px) scale(1.3); opacity: 0.6; }
}

/* Container */
.s10-container { max-width: 1300px; margin: 0 auto; padding: 0 40px; position: relative; z-index: 2; }

/* ---- Main Layout: Split Columns ---- */
.s10-main-layout {
    display: grid;
    grid-template-columns: minmax(500px, 1fr) auto;
    gap: 40px;
    margin-bottom: 50px;
    align-items: stretch;
    position: relative;
}

.s10-left-col {
    position: relative; z-index: 10;
    opacity: 0; transform: translateY(40px);
    transition: all 1.2s cubic-bezier(0.22,1,0.36,1) 0.3s;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.s10-getstarted-section.revealed .s10-left-col { opacity: 1; transform: translateY(0); }

/* Center Section Header at the Top */
.s10-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 10;
}
.s10-header .s10-gold-divider {
    margin: 0 auto 20px;
}
.s10-header .s10-paragraph {
    max-width: 600px;
}

.s10-eyebrow {
