  right: 2px;
  border-bottom: 1.8px solid #D4A54A;
  border-right: 1.8px solid #D4A54A;
}
.req-profile-tag-icon::after {
  content: '✦';
  position: absolute;
  top: -6px;
  right: -4px;
  color: #D4A54A;
  font-size: 8px;
  font-weight: bold;
  text-shadow: 0 0 4px rgba(212, 165, 74, 0.8);
  z-index: 4;
  animation: sparkPulse 2s infinite ease-in-out;
}
@keyframes sparkPulse {
  0%, 100% { opacity: 0.6; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

.req-profile-tag-text {
  display: flex;
  flex-direction: column;
  font-family: 'Inter', sans-serif;
  line-height: 1.15;
  z-index: 3;
  align-items: center;
  text-align: center;
}
.req-profile-tag-text span {
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
}
.req-profile-tag-text strong {
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #FFFFFF;
  text-transform: uppercase;
  margin-top: 2px;
}
.req-profile-tag-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin-top: 6px;
  width: 80px;
}
.req-profile-tag-divider .line {
  height: 1px;
  flex-grow: 1;
  background: linear-gradient(90deg, transparent, rgba(212, 165, 74, 0.5), transparent);
}
.req-profile-tag-divider .diamond {
  width: 4px;
  height: 4px;
  background: #D4A54A;
  transform: rotate(45deg);
  box-shadow: 0 0 3px #D4A54A;
}

.req-profile-list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-grow: 1;
  padding: 0 48px 0 96px;
  z-index: 1;
}

.req-profile-item {
  display: flex;
  align-items: center;
  gap: 16px;
  max-width: 220px;
  text-align: left;
}

.req-profile-icon-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  width: 46px;
  height: 46px;
}

.req-profile-icon-circle {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 30%, #FFFFFF 0%, #FAF6EE 60%, #E9DFC9 100%);
  border: 1px solid rgba(212, 165, 74, 0.28);
  box-shadow:
    inset 0 2px 3px rgba(255, 255, 255, 0.9),
    inset 0 -2px 3px rgba(0, 0, 0, 0.05),
    0 6px 14px rgba(212, 165, 74, 0.12),
    0 2px 4px rgba(0, 0, 0, 0.04);
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, background 0.4s ease, border-color 0.4s ease;
  position: relative;
}
.req-profile-icon-circle svg {
  width: 20px;
  height: 20px;
  color: #A37F43;
  transition: transform 0.4s ease, color 0.4s ease;
}
.req-profile-item:hover .req-profile-icon-circle {
  background: #071D3A;
  border-color: #D4A54A;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.15),
    0 8px 20px rgba(7, 29, 58, 0.3),
    0 0 15px rgba(212, 165, 74, 0.25);
  transform: translateY(-3px) scale(1.05);
}
.req-profile-item:hover .req-profile-icon-circle svg {
  color: #D4A54A;
  transform: rotate(5deg) scale(1.05);
}

.req-profile-item-dot {
  width: 4px;
  height: 4px;
  background: #D4A54A;
  border-radius: 50%;
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 5px rgba(212, 165, 74, 0.9);
  opacity: 0.8;
  transition: transform 0.3s ease, background-color 0.3s ease;
}
.req-profile-item:hover .req-profile-item-dot {
  transform: translateX(-50%) scale(1.3);
  background-color: #F47A2A;
  box-shadow: 0 0 6px rgba(244, 122, 42, 0.9);
}

.req-profile-item-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.76rem;
  line-height: 1.4;
  color: #071D3A;
  font-weight: 550;
  margin: 0;
}

.req-profile-divider {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(212, 165, 74, 0.25), transparent);
}

/* ======== SECTION 4: RESPONSIVE MEDIA QUERIES ======== */
@media (max-width: 1200px) {
  .req-top-row {
    gap: 40px;
  }
  .req-grid-container {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .req-chevron {
    display: none;
  }
  .req-card {
    height: auto;
    min-height: 270px;
  }
  .req-profile-tray {
    height: auto;
    flex-direction: column;
    align-items: stretch;
  }
  .req-profile-tag {
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 0;
    border-bottom: 1px solid rgba(212, 165, 74, 0.2);
    justify-content: center;
    padding: 20px 24px;
  }
  .req-profile-tag::after {
    display: none;
  }
  .req-profile-list {
    padding: 24px;
    gap: 24px 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .req-profile-item {
    flex: 0 0 calc(50% - 12px);
    max-width: 220px;
  }
  .req-profile-divider {
    display: none;
  }
}

@media (max-width: 768px) {
  .req-section {
    padding: 80px 0 60px;
  }
  .req-top-row {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 30px;
    margin-bottom: 40px;
  }
  .req-header-info {
    max-width: 100%;
  }
  .req-heading {
    align-items: center;
  }
  .req-desc {
    margin-left: auto;
    margin-right: auto;
  }
  .req-stage-visual {
    max-width: 100%;
  }
  .req-stage-wrapper {
    width: 320px;
    height: 240px;
  }
}

@media (max-width: 640px) {
  .req-grid-container {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .req-profile-list {
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .req-profile-item {
    flex: 0 0 100%;
    justify-content: flex-start;
    width: 100%;
    max-width: 260px;
  }
}

