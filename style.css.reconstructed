.st-feature-card {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(25px) saturate(190%);
    -webkit-backdrop-filter: blur(25px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 20px;
    padding: 24px;
    min-height: 125px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 
        inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
        inset 0 -1px 0 0 rgba(255, 255, 255, 0.2),
        0 8px 30px rgba(0, 0, 0, 0.02);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.st-feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
    z-index: 1;
}

.st-feature-card .st-card-glow {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 1;
}

.st-feature-card[data-card="1"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(249, 115, 22, 0.12) 0%, transparent 60%); }
.st-feature-card[data-card="2"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 119, 182, 0.12) 0%, transparent 60%); }
.st-feature-card[data-card="3"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(42, 157, 143, 0.12) 0%, transparent 60%); }
.st-feature-card[data-card="4"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(209, 166, 84, 0.12) 0%, transparent 60%); }
.st-feature-card[data-card="5"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(231, 111, 81, 0.12) 0%, transparent 60%); }
.st-feature-card[data-card="6"] .st-card-glow { background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(181, 23, 158, 0.12) 0%, transparent 60%); }

.st-feature-card:hover .st-card-glow,
.st-feature-card.nearest-card .st-card-glow {
    opacity: 1;
}

.st-section.revealed .st-feature-card:hover,
.st-section.revealed .st-feature-card.nearest-card {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.85);
}

.st-feature-card[data-card="1"]:hover, .st-feature-card[data-card="1"].nearest-card { border-color: rgba(249, 115, 22, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(249, 115, 22, 0.08), 0 0 15px rgba(249, 115, 22, 0.04); }
.st-feature-card[data-card="2"]:hover, .st-feature-card[data-card="2"].nearest-card { border-color: rgba(0, 119, 182, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(0, 119, 182, 0.08), 0 0 15px rgba(0, 119, 182, 0.04); }
.st-feature-card[data-card="3"]:hover, .st-feature-card[data-card="3"].nearest-card { border-color: rgba(42, 157, 143, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(42, 157, 143, 0.08), 0 0 15px rgba(42, 157, 143, 0.04); }
.st-feature-card[data-card="4"]:hover, .st-feature-card[data-card="4"].nearest-card { border-color: rgba(209, 166, 84, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(209, 166, 84, 0.08), 0 0 15px rgba(209, 166, 84, 0.04); }
.st-feature-card[data-card="5"]:hover, .st-feature-card[data-card="5"].nearest-card { border-color: rgba(231, 111, 81, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(231, 111, 81, 0.08), 0 0 15px rgba(231, 111, 81, 0.04); }
.st-feature-card[data-card="6"]:hover, .st-feature-card[data-card="6"].nearest-card { border-color: rgba(181, 23, 158, 0.35); box-shadow: inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8), 0 12px 30px rgba(181, 23, 158, 0.08), 0 0 15px rgba(181, 23, 158, 0.04); }

.st-feature-card .st-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.8);
}

.st-feature-card[data-card="1"] .st-icon { border: 1.5px solid rgba(249, 115, 22, 0.3); color: #F97316; box-shadow: 0 4px 12px rgba(249, 115, 22, 0.06); }
.st-feature-card[data-card="2"] .st-icon { border: 1.5px solid rgba(0, 119, 182, 0.3); color: #0077B6; box-shadow: 0 4px 12px rgba(0, 119, 182, 0.06); }
.st-feature-card[data-card="3"] .st-icon { border: 1.5px solid rgba(42, 157, 143, 0.3); color: #2A9D8F; box-shadow: 0 4px 12px rgba(42, 157, 143, 0.06); }
.st-feature-card[data-card="4"] .st-icon { border: 1.5px solid rgba(209, 166, 84, 0.3); color: #D1A654; box-shadow: 0 4px 12px rgba(209, 166, 84, 0.06); }
.st-feature-card[data-card="5"] .st-icon { border: 1.5px solid rgba(231, 111, 81, 0.3); color: #E76F51; box-shadow: 0 4px 12px rgba(231, 111, 81, 0.06); }
.st-feature-card[data-card="6"] .st-icon { border: 1.5px solid rgba(181, 23, 158, 0.3); color: #B5179E; box-shadow: 0 4px 12px rgba(181, 23, 158, 0.06); }

.st-feature-card:hover .st-icon,
.st-feature-card.nearest-card .st-icon {
    transform: rotate(8deg) scale(1.08);
}

.st-feature-card .st-card-text {
    position: relative;
    z-index: 2;
}

.st-feature-card .st-card-text h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #121826;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 6px;
    position: relative;
    display: inline-block;
}

.st-feature-card .st-card-text h5::after {
    content: '';
    display: block;
    width: 24px;
    height: 2px;
    margin-top: 4px;
    border-radius: 1px;
    transition: width 0.3s ease;
}

.st-feature-card[data-card="1"] .st-card-text h5::after { background-color: #F97316; }
.st-feature-card[data-card="2"] .st-card-text h5::after { background-color: #0077B6; }
.st-feature-card[data-card="3"] .st-card-text h5::after { background-color: #2A9D8F; }
.st-feature-card[data-card="4"] .st-card-text h5::after { background-color: #D1A654; }
.st-feature-card[data-card="5"] .st-card-text h5::after { background-color: #E76F51; }
.st-feature-card[data-card="6"] .st-card-text h5::after { background-color: #B5179E; }

.st-feature-card:hover .st-card-text h5::after,
.st-feature-card.nearest-card .st-card-text h5::after {
    width: 100%;
}

.st-feature-card .st-card-text p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.45;
    margin: 0;
}

/* Scroll word-by-word reveal style */
.st-reveal-line {
    display: block;
    overflow: hidden;
}

.reveal-word {
    display: inline-block;
    overflow: hidden;
    margin-right: 0.18em;
    vertical-align: bottom;
}

.reveal-word-inner {
    display: inline-block;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1);
}

.st-section.revealed .reveal-word-inner {
    transform: translateY(0);
    opacity: 1;
}

/* Scroll reveal for left feature cards */
.st-feature-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
}

.st-section.revealed .st-feature-card[data-card="1"] { opacity: 1; transform: translateY(0); transition-delay: 0.2s; }
.st-section.revealed .st-feature-card[data-card="2"] { opacity: 1; transform: translateY(0); transition-delay: 0.3s; }
.st-section.revealed .st-feature-card[data-card="3"] { opacity: 1; transform: translateY(0); transition-delay: 0.4s; }
.st-section.revealed .st-feature-card[data-card="4"] { opacity: 1; transform: translateY(0); transition-delay: 0.5s; }
.st-section.revealed .st-feature-card[data-card="5"] { opacity: 1; transform: translateY(0); transition-delay: 0.6s; }
.st-section.revealed .st-feature-card[data-card="6"] { opacity: 1; transform: translateY(0); transition-delay: 0.7s; }

/* Right Side: Growth Graph */
.st-right-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: stretch;
    position: relative;
}

.st-graph-container {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 24px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.02);
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
}

.st-graph-y-axis {
    position: absolute;
    left: 15px;
    top: 30px;
    bottom: 75px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    align-items: flex-end;
    width: 90px;
    pointer-events: none;
}

.st-graph-y-axis span {
    font-family: 'Outfit', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
}

.st-graph-canvas-wrap {
    margin-left: 105px;
    position: relative;
    flex-grow: 1;
    min-height: 380px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    border: 1px dashed rgba(15, 23, 42, 0.04);
    overflow: hidden;
}

.st-graph-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
}

.st-graph-grid line {
    stroke: rgba(15, 23, 42, 0.03);
    stroke-width: 1.5;
}

/* Drawing animations scroll triggered */
.st-graph-path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 2s cubic-bezier(0.22, 1, 0.36, 1);
}

.st-section.revealed .st-graph-path {
    stroke-dashoffset: 0;
}

.st-graph-fill {
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
}

.st-section.revealed .st-graph-fill {
    opacity: 1;
}

.st-graph-pulse {
    stroke-dasharray: 60 1000;
    animation: graphPulse 5s linear infinite;
}

@keyframes graphPulse {
    0% { stroke-dashoffset: 1000; }
    100% { stroke-dashoffset: 0; }
}

.st-graph-particle {
    opacity: 0;
}

.st-section.revealed .st-graph-particle {
    opacity: 1;
    transition: opacity 0.5s ease 0.3s;
}

/* Milestone Nodes */
/* 3D Pillars Staircase Columns */
.st-graph-pillars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
}

.st-pillar {
    position: absolute;
    bottom: 0;
    width: 54px;
    transform: translateX(-50%);
    transform-style: preserve-3d;
    pointer-events: auto;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s;
}

.st-pillar-front {
    position: absolute;
    top: 0px;
    left: 0;
    width: 27px;
    height: 100%;
    clip-path: polygon(0 0, 27px 9.8px, 27px 100%, 0 100%);
    -webkit-clip-path: polygon(0 0, 27px 9.8px, 27px 100%, 0 100%);
    transition: background 0.3s, filter 0.3s;
    box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.05);
}

.st-pillar-side {
    position: absolute;
    top: 0px;
    left: 27px;
    width: 27px;
    height: 100%;
    clip-path: polygon(0 9.8px, 27px 0, 27px 100%, 0 100%);
    -webkit-clip-path: polygon(0 9.8px, 27px 0, 27px 100%, 0 100%);
    transition: background 0.3s, filter 0.3s;
}

.st-pillar-top {
    position: absolute;
    left: 0;
    width: 54px;
    height: 19.6px;
    top: -9.8px;
    clip-path: polygon(27px 0, 54px 9.8px, 27px 19.6px, 0 9.8px);
    -webkit-clip-path: polygon(27px 0, 54px 9.8px, 27px 19.6px, 0 9.8px);
    transition: background 0.3s, filter 0.3s;
    z-index: 4;
}

/* Pillar Icons */
.st-pillar-icon {
    width: 14px;
    height: 14px;
    color: rgba(255, 255, 255, 0.95);
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
}

/* Specific theme color styling for the 6 pillars */
/* Pillar 1: Navy */
#st-pillar-1 .st-pillar-front { background: linear-gradient(180deg, #1D3557 0%, #102035 100%); }
#st-pillar-1 .st-pillar-side { background: linear-gradient(180deg, #102035 0%, #08101B 100%); }
#st-pillar-1 .st-pillar-top { background: #2E4C74; }

/* Pillar 2: Ocean Blue */
#st-pillar-2 .st-pillar-front { background: linear-gradient(180deg, #0077B6 0%, #005F92 100%); }
#st-pillar-2 .st-pillar-side { background: linear-gradient(180deg, #005F92 0%, #003F62 100%); }
#st-pillar-2 .st-pillar-top { background: #0096C7; }

/* Pillar 3: Vibrant Orange */
#st-pillar-3 .st-pillar-front { background: linear-gradient(180deg, #F97316 0%, #C75438 100%); }
#st-pillar-3 .st-pillar-side { background: linear-gradient(180deg, #C75438 0%, #9C3D26 100%); }
#st-pillar-3 .st-pillar-top { background: #FA934C; }

/* Pillar 4: Tan/Gold */
#st-pillar-4 .st-pillar-front { background: linear-gradient(180deg, #D1A654 0%, #A8823C 100%); }
#st-pillar-4 .st-pillar-side { background: linear-gradient(180deg, #A8823C 0%, #7E622B 100%); }
#st-pillar-4 .st-pillar-top { background: #E4BD73; }

/* Pillar 5: Deep Teal */
#st-pillar-5 .st-pillar-front { background: linear-gradient(180deg, #2A9D8F 0%, #15554D 100%); }
#st-pillar-5 .st-pillar-side { background: linear-gradient(180deg, #15554D 0%, #0E3D37 100%); }
#st-pillar-5 .st-pillar-top { background: #3ABEB0; }

/* Pillar 6: Magenta/Fuchsia */
#st-pillar-6 .st-pillar-front { background: linear-gradient(180deg, #B5179E 0%, #8F0075 100%); }
#st-pillar-6 .st-pillar-side { background: linear-gradient(180deg, #8F0075 0%, #670054 100%); }
#st-pillar-6 .st-pillar-top { background: #D82CB8; }

/* Interactive Hover Lighting of Pillars */
.st-pillar.nearest {
    transform: translateX(-50%) translateY(-6px) scale(1.05);
}

.st-pillar.nearest .st-pillar-front { filter: brightness(1.18) saturate(1.1); }
.st-pillar.nearest .st-pillar-side { filter: brightness(1.18) saturate(1.1); }
.st-pillar.nearest .st-pillar-top { filter: brightness(1.18) saturate(1.1); }

/* Center nodes on the top face of the pillar: center of width (27px) and top edge (0px) */
.st-pillar .st-node {
    position: absolute !important;
    left: 27px !important;
    top: 0px !important;
    transform-origin: center !important;
    pointer-events: auto;
    z-index: 10;
}

/* Control state transforms using standard scales without skew cancelations */
.st-node {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.st-section.revealed #st-node-1 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 0.6s; }
.st-section.revealed #st-node-2 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 0.8s; }
.st-section.revealed #st-node-3 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 1.0s; }
.st-section.revealed #st-node-4 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 1.2s; }
.st-section.revealed #st-node-5 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 1.4s; }
.st-section.revealed #st-node-6 { opacity: 1; transform: translate(-50%, -50%) scale(1); transition-delay: 1.6s; }

.st-node:hover,
.st-node.nearest {
    opacity: 1 !important;
    transform: translate(-50%, -50%) scale(1.2) !important;
}

/* Dot style */
.st-node-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 3px solid #F97316;
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: nodeBreathe 3s ease-in-out infinite alternate;
}

.st-node-num {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 800;
    color: #0F172A;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    pointer-events: none;
}

@keyframes nodeBreathe {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
}

.st-node-dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(249, 115, 22, 0.3);
    opacity: 0;
    animation: nodeRipple 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
}

@keyframes nodeRipple {
    0% { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.8); opacity: 0; }
}

/* Colors for specific node dot borders to match their pillars */
#st-node-1 .st-node-dot { border-color: #1D3557; box-shadow: 0 0 8px rgba(29, 53, 87, 0.4); }
#st-node-2 .st-node-dot { border-color: #0077B6; box-shadow: 0 0 8px rgba(0, 119, 182, 0.4); }
#st-node-3 .st-node-dot { border-color: #F97316; box-shadow: 0 0 8px rgba(249, 115, 22, 0.4); }
#st-node-4 .st-node-dot { border-color: #D1A654; box-shadow: 0 0 8px rgba(209, 166, 84, 0.4); }
#st-node-5 .st-node-dot { border-color: #2A9D8F; box-shadow: 0 0 8px rgba(42, 157, 143, 0.4); }
#st-node-6 .st-node-dot { border-color: #B5179E; box-shadow: 0 0 12px #B5179E, 0 0 24px rgba(181, 23, 158, 0.3); }

/* Success glow node 6 override */
#st-node-6 .st-node-dot {
    animation: finalNodeGlow 2s ease-in-out infinite alternate;
}

@keyframes finalNodeGlow {
    0% { box-shadow: 0 0 12px #B5179E, 0 0 24px rgba(181, 23, 158, 0.3); transform: scale(1); }
    100% { box-shadow: 0 0 22px #D82CB8, 0 0 45px rgba(216, 44, 184, 0.6); transform: scale(1.15); }
}

.st-node-tooltip {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.9);
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 10px 14px;
    width: 140px;
    color: #FFFFFF;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.st-node-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px;
    border-style: solid;
    border-color: rgba(15, 23, 42, 0.95) transparent transparent transparent;
}

.st-node:hover .st-node-tooltip,
.st-node.nearest .st-node-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
}

/* Node 1 Tooltip (Shunted Right) */
#st-node-1 .st-node-tooltip {
    left: 20px;
    transform: translateY(10px) scale(0.9);
}
#st-node-1 .st-node-tooltip::after {
    left: 10px;
    transform: none;
}

/* Node 6 Tooltip (Shunted Left) */
#st-node-6 .st-node-tooltip {
    left: auto;
    right: 20px;
    transform: translateY(10px) scale(0.9);
}
#st-node-6 .st-node-tooltip::after {
    left: auto;
    right: 10px;
    transform: none;
}

.st-node-tooltip-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.st-node-icon {
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.9);
}

.st-node-icon svg {
    width: 100%;
    height: 100%;
}

.st-node-step {
    font-family: 'Outfit', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    color: #94A3B8;
}

.st-node-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: #E2E8F0;
    line-height: 1.2;
}

/* Floating KPI Chips */
.st-floating-kpis {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
}

.st-kpi-chip {
    position: absolute;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(15, 23, 42, 0.05);
    border-radius: 50px;
    padding: 8px 16px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #475569;
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.02);
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.st-kpi-chip span {
    color: #F97316;
    font-weight: 700;
}

.st-section.revealed .st-kpi-chip {
    opacity: 1;
    transform: translateY(0);
}

.st-kpi-chip.kpi-1 { top: 22%; left: 8%; --base-float-y: 0px; animation: floatKpi1 6s ease-in-out infinite; transition-delay: 0.8s; }
.st-kpi-chip.kpi-2 { top: 12%; left: 45%; --base-float-y: 0px; animation: floatKpi2 8s ease-in-out infinite; transition-delay: 1.0s; }
.st-kpi-chip.kpi-3 { top: 48%; left: 75%; --base-float-y: 0px; animation: floatKpi3 7s ease-in-out infinite; transition-delay: 1.2s; }
.st-kpi-chip.kpi-4 { top: 82%; left: 52%; --base-float-y: 0px; animation: floatKpi4 9s ease-in-out infinite; transition-delay: 1.4s; }
.st-kpi-chip.kpi-5 { top: 62%; left: 15%; --base-float-y: 0px; animation: floatKpi1 8s ease-in-out infinite; transition-delay: 1.1s; }
.st-kpi-chip.kpi-6 { top: 38%; left: 88%; --base-float-y: 0px; animation: floatKpi2 7s ease-in-out infinite; transition-delay: 1.3s; }

@keyframes floatKpi1 {
    0%, 100% { transform: translateY(var(--base-float-y, 0px)); }
    50% { transform: translateY(calc(var(--base-float-y, 0px) - 8px)); }
}

@keyframes floatKpi2 {
    0%, 100% { transform: translateY(var(--base-float-y, 0px)); }
    50% { transform: translateY(calc(var(--base-float-y, 0px) - 10px)); }
}

@keyframes floatKpi3 {
    0%, 100% { transform: translateY(var(--base-float-y, 0px)); }
    50% { transform: translateY(calc(var(--base-float-y, 0px) - 7px)); }
}

@keyframes floatKpi4 {
    0%, 100% { transform: translateY(var(--base-float-y, 0px)); }
    50% { transform: translateY(calc(var(--base-float-y, 0px) - 9px)); }
}

.st-graph-x-axis {
    display: flex;
    justify-content: space-between;
    margin-left: 105px;
    margin-top: 15px;
    pointer-events: none;
}

.st-graph-x-axis span {
    font-family: 'Outfit', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100px;
    text-align: center;
}

/* Bottom Ribbon Trust Bar - Apple Liquid Glass Effect */
.st-bottom-strip.ribbon-layout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 24px;
    padding: 24px 36px;
    gap: 20px;
    box-shadow: 0 10px 45px rgba(15, 23, 42, 0.02);
    margin-top: 60px;
}

.st-bottom-strip.ribbon-layout .st-capsule {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    padding: 16px 20px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.45);
    position: relative;
    overflow: hidden;
    box-shadow: 
        inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
        0 8px 24px rgba(0, 0, 0, 0.02);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.4s ease,
                box-shadow 0.4s ease;
}

.st-bottom-strip.ribbon-layout .st-capsule::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
    z-index: 1;
}

.st-bottom-strip.ribbon-layout .st-capsule::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    transform: scaleX(0.15);
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), height 0.3s;
    border-radius: 3px 3px 0 0;
}

.st-bottom-strip.ribbon-layout .st-capsule:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 
        inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
        0 14px 30px rgba(0, 0, 0, 0.04);
}

.st-bottom-strip.ribbon-layout .st-capsule:hover::after {
    transform: scaleX(1);
    height: 4px;
}

/* Capsule individual custom line and icon colors */
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(1)::after { background-color: #1D3557; }
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(1) .st-capsule-icon { border: 1.5px solid rgba(29, 53, 87, 0.3); color: #1D3557; background: rgba(255, 255, 255, 0.8); }

.st-bottom-strip.ribbon-layout .st-capsule:nth-child(2)::after { background-color: #0077B6; }
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(2) .st-capsule-icon { border: 1.5px solid rgba(0, 119, 182, 0.3); color: #0077B6; background: rgba(255, 255, 255, 0.8); }

.st-bottom-strip.ribbon-layout .st-capsule:nth-child(3)::after { background-color: #F97316; }
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(3) .st-capsule-icon { border: 1.5px solid rgba(249, 115, 22, 0.3); color: #F97316; background: rgba(255, 255, 255, 0.8); }

.st-bottom-strip.ribbon-layout .st-capsule:nth-child(4)::after { background-color: #2A9D8F; }
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(4) .st-capsule-icon { border: 1.5px solid rgba(42, 157, 143, 0.3); color: #2A9D8F; background: rgba(255, 255, 255, 0.8); }

.st-bottom-strip.ribbon-layout .st-capsule:nth-child(5)::after { background-color: #B5179E; }
.st-bottom-strip.ribbon-layout .st-capsule:nth-child(5) .st-capsule-icon { border: 1.5px solid rgba(181, 23, 158, 0.3); color: #B5179E; background: rgba(255, 255, 255, 0.8); }

.st-bottom-strip.ribbon-layout .st-capsule-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s;
}

.st-bottom-strip.ribbon-layout .st-capsule:hover .st-capsule-icon {
    transform: scale(1.08);
}

.st-bottom-strip.ribbon-layout .st-capsule-icon svg {
    width: 18px;
    height: 18px;
}

.st-bottom-strip.ribbon-layout .st-capsule-text {
    position: relative;
    z-index: 2;
}

.st-bottom-strip.ribbon-layout .st-capsule-text h6 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 4px;
    line-height: 1.2;
}

.st-bottom-strip.ribbon-layout .st-capsule-text p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    color: #475569;
    line-height: 1.35;
    margin: 0;
}

/* Watermark capsule numbers */
.st-capsule-num {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: rgba(15, 23, 42, 0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition: color 0.3s;
    z-index: 1;
}

.st-bottom-strip.ribbon-layout .st-capsule:hover .st-capsule-num {
    color: rgba(15, 23, 42, 0.08);
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .st-top-row {
        grid-template-columns: 1fr;
        gap: 50px;
    }
    .st-left-col, .st-right-col {
        width: 100%;
