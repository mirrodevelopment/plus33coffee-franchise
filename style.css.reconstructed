}

/* ==========================================================================
   Center Ecosystem & Donut Chart
   ========================================================================== */
.revenue-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.donut-chart-wrapper {
  position: relative;
  width: 480px;
  height: 480px;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Golden Orbit Ring */
.orbit-ring {
  position: absolute;
  width: 330px;
  height: 330px;
  border: 1.5px dashed rgba(217, 164, 65, 0.35);
  border-radius: var(--radius-full);
  pointer-events: none;
  z-index: 5;
  animation: rotateOrbit 40s linear infinite;
}

/* Orbital Spark Particle */
.orbit-ring::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -4px;
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background: var(--rev-gold);
  box-shadow: 0 0 12px var(--rev-gold), 0 0 20px var(--rev-gold);
}

@keyframes rotateOrbit {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Donut Chart Glow & Reflective Effects */
.donut-glow {
  position: absolute;
  width: 250px;
  height: 250px;
  border-radius: var(--radius-full);
  background: radial-gradient(circle, rgba(217, 164, 65, 0.12) 0%, transparent 70%);
  pointer-events: none;
  z-index: 4;
}

.donut-svg {
  width: 240px;
  height: 240px;
  transform: rotate(-90deg); /* Start Beverage segment at the top */
  filter: drop-shadow(0 15px 35px rgba(6, 27, 54, 0.1));
  z-index: 6;
  position: relative;
}

.donut-segment {
  cursor: pointer;
  transition: stroke-width 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
              stroke-dashoffset 1.8s cubic-bezier(0.16, 1, 0.3, 1), 
              filter 0.4s ease;
}

.donut-segment:hover,
.donut-segment.active {
  stroke-width: 23px;
  filter: drop-shadow(0 0 12px var(--rev-gold));
}

/* Logo Center Circle */
.donut-center-circle {
  position: absolute;
  width: 150px;
  height: 150px;
  border-radius: var(--radius-full);
  background: var(--rev-bg);
  border: 1.5px solid rgba(217, 164, 65, 0.35);
  box-shadow: inset 0 2px 10px rgba(0,0,0,0.05), 0 10px 30px rgba(6, 27, 54, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 7;
  pointer-events: none;
}

.donut-logo {
  width: 134px;
  height: 134px;
  object-fit: contain;
  border-radius: var(--radius-full);
  background: var(--white);
}

/* SVG Connector Lines */
.connector-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}

.connector-path {
  stroke: rgba(217, 164, 65, 0.25);
  stroke-width: 1;
  stroke-dasharray: 6 6;
  stroke-dashoffset: 0;
  transition: all 0.5s ease;
}

.connector-path.active {
  stroke: var(--rev-gold);
  stroke-width: 2.5;
  stroke-dasharray: 6 3;
  animation: pulseLine 1s linear infinite;
  filter: drop-shadow(0 0 4px var(--rev-gold));
}

@keyframes pulseLine {
  to { stroke-dashoffset: -30; }
}

/* Floating Info Cards */
.floating-cat-card {
  position: absolute;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(217, 164, 65, 0.15);
  border-radius: var(--radius-lg);
  padding: 0.75rem 1rem;
  box-shadow: 0 10px 25px rgba(6, 27, 54, 0.04);
