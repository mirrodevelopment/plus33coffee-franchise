        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .franchise-journey-section.revealed .s8-step-text {
        opacity: 1;
        transform: translateY(0) !important;
    }

    .step-below .s8-step-text,
    .step-above .s8-step-text {
        transform: translateY(15px) !important;
    }

    .franchise-journey-section.revealed .step-below .s8-step-text,
    .franchise-journey-section.revealed .step-above .s8-step-text {
        transform: translateY(0) !important;
    }

    .s8-step-number {
        font-size: 1.2rem;
        margin-bottom: 4px;
    }

    .s8-step-text h6 {
