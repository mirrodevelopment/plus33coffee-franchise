    font-size: 0.8rem;
    font-weight: 700;
    color: #D9A441;
}

.cta-text h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #D9A441;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

.cta-text p {
    font-size: 0.95rem;
    color: #F8F5EE;
    margin: 0;
}

.cta-right {
    position: relative;
    z-index: 2;
}

.s8-btn-gold {
    background: linear-gradient(90deg, #D9A441 0%, #D46A28 100%);
    color: #FFF;
    padding: 16px 32px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    display: inline-flex;
    align-items: center;
