/* ==========================================================================
   REVENUE STREAMS SECTION STYLES
   ========================================================================== */

:root {
  --rev-bg: #F8F4EE;
  --rev-navy: #061B36;
  --rev-gold: #D9A441;
  --rev-orange: #F06B23;
  --rev-teal: #167D86;
  --rev-slate: #7A8CA3;
  --rev-text: #1A1A1A;
  
  --shadow-gold: 0 10px 30px rgba(217, 164, 65, 0.15);
  --shadow-navy: 0 20px 40px rgba(6, 27, 54, 0.12);
  --shadow-luxury: 0 15px 40px rgba(0, 0, 0, 0.04);
}

.revenue-section {
  background-color: var(--rev-bg);
  color: var(--rev-text);
  padding: 8rem 4rem;
  position: relative;
  overflow: hidden;
  z-index: 5;
}

/* Cinematic Moving Spotlight */
.revenue-spotlight {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 10% 20%, rgba(217, 164, 65, 0.04) 0%, transparent 50%),
              radial-gradient(circle at 90% 80%, rgba(240, 107, 35, 0.03) 0%, transparent 50%);
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: color-burn;
}

.revenue-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}

.revenue-container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 5rem;
  align-items: center;
  position: relative;
  z-index: 3;
}

/* ==========================================================================
   Centered Header Block
   ========================================================================== */
.revenue-header {
  position: relative;
  z-index: 4;
  text-align: center;
  max-width: 800px;
  margin: 0 auto 52px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20px;
}

.revenue-header .rev-heading {
  text-align: center;
  display: flex;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 0.5rem !important;
  white-space: nowrap !important;
  flex-wrap: nowrap !important;
}

.revenue-header .rev-divider {
  justify-content: center;
}

.revenue-header .rev-description {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}

.rev-eyebrow {
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--rev-gold);
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.rev-heading {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 3.8vw, 4.2rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  white-space: nowrap !important;
  flex-wrap: nowrap !important;
}

.rev-heading .word {
  display: inline-block !important;
  white-space: nowrap !important;
  font-weight: 800;
}

.rev-heading .navy-line {
