        display: none;
    }
    .st-graph-canvas-wrap {
        margin-left: 0;
        height: 280px;
        min-height: auto;
    }
    .st-graph-x-axis {
        margin-left: 0;
        position: relative;
        height: 20px;
        margin-top: 10px;
    }
    .st-graph-x-axis span {
        position: absolute;
        font-size: 0.45rem;
        line-height: 1.2;
        white-space: nowrap;
        text-align: center;
        letter-spacing: 0.02em;
        transform: translateX(-50%);
        width: auto;
    }
    .st-graph-x-axis span:nth-child(1) { left: 5.7%; }
    .st-graph-x-axis span:nth-child(2) { left: 22.9%; }
    .st-graph-x-axis span:nth-child(3) { left: 40%; }
    .st-graph-x-axis span:nth-child(4) { left: 57.1%; }
    .st-graph-x-axis span:nth-child(5) { left: 74.3%; }
    .st-graph-x-axis span:nth-child(6) { left: 91.4%; }
    
    /* Scale nodes and make tooltips compact to avoid overlap */
    .st-node-dot {
        width: 18px;
        height: 18px;
        border-width: 2.5px;
    }
    .st-node-tooltip {
        width: 105px;
        padding: 6px 8px;
        bottom: 24px;
    }
    .st-node-label {
