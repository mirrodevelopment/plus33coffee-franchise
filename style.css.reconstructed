/* ====================================================================
   SECTION 09: THE PLUS33 OPPORTUNITY — ULTRA LUXURY GROWTH STEPS
   ==================================================================== */

.s9-opportunity-section {
    position: relative;
    background: linear-gradient(180deg, #FAF8F5 0%, #F3EFEA 50%, #FAF8F5 100%);
    padding: 120px 0 80px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.s9-opportunity-section.revealed {
    opacity: 1;
}

/* Ambient Lighting */
.s9-ambient-glow {
    position: absolute;
    top: 10%; left: 50%;
    width: 800px; height: 600px;
    background: radial-gradient(ellipse, rgba(217, 164, 65, 0.08) 0%, transparent 70%);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
    animation: s9AmbientPulse 8s ease-in-out infinite alternate;
}

@keyframes s9AmbientPulse {
    0% { opacity: 0.5; transform: translateX(-50%) scale(1); }
    100% { opacity: 1; transform: translateX(-50%) scale(1.15); }
}

.s9-spotlight {
    position: absolute;
    top: -80px; left: 50%;
    width: 500px; height: 400px;
    background: radial-gradient(ellipse at center top, rgba(217, 164, 65, 0.12) 0%, transparent 70%);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 2s ease 0.5s;
}

.s9-opportunity-section.revealed .s9-spotlight {
    opacity: 1;
}

.s9-particles {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 1;
}

.s9-particle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.6) 0%, transparent 70%);
    pointer-events: none;
}

@keyframes s9ParticleFloat {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.3; }
    25% { transform: translate(15px, -20px) scale(1.2); opacity: 0.7; }
    50% { transform: translate(-10px, -40px) scale(0.9); opacity: 0.4; }
    75% { transform: translate(20px, -15px) scale(1.1); opacity: 0.6; }
}

/* Container */
.s9-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
}

/* ---- Two Column Layout ---- */
.s9-two-col {
    display: flex;
    gap: 60px;
    align-items: flex-start;
    margin-bottom: 60px;
}

.s9-left-col {
    flex: 0 0 35%;
    max-width: 35%;
    padding-top: 20px;
    opacity: 0;
    transform: translateY(40px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
}

.s9-opportunity-section.revealed .s9-left-col {
    opacity: 1;
    transform: translateY(0);
}

.s9-right-col {
    flex: 1;
    min-width: 0;
}

/* ---- Eyebrow ---- */
.s9-eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: #D46A28;
    text-transform: uppercase;
    margin-bottom: 12px;
    opacity: 0;
    transform: translateX(-30px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
}

.s9-opportunity-section.revealed .s9-eyebrow {
    opacity: 1;
    transform: translateX(0);
}

/* ---- Gold Divider ---- */
.s9-gold-divider {
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #D9A441 0%, rgba(217, 164, 65, 0.2) 100%);
    margin-bottom: 20px;
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.7s;
}

.s9-opportunity-section.revealed .s9-gold-divider {
    width: 60px;
}

/* ---- Heading ---- */
.s9-heading {
    font-family: 'Playfair Display', serif;
    font-size: 3.6rem;
    font-weight: 800;
    color: #1B2A4A;
    line-height: 1.15;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(25px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.8s;
}

.s9-opportunity-section.revealed .s9-heading {
    opacity: 1;
    transform: translateY(0);
}

.s9-heading-orange {
    color: #D46A28;
    font-style: italic;
}

/* ---- Paragraph ---- */
.s9-paragraph {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    color: #4A5B6D;
    line-height: 1.7;
    margin-bottom: 35px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 1s;
}

.s9-opportunity-section.revealed .s9-paragraph {
    opacity: 1;
    transform: translateY(0);
}

/* ---- "The Time Is Now" Card ---- */
.s9-time-card {
    position: relative;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 22px 24px;
    border: 1px solid rgba(212, 106, 40, 0.25);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px) scale(0.96);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1) 1.2s;
}

.s9-opportunity-section.revealed .s9-time-card {
    opacity: 1;
    transform: translateY(0) scale(1);
}

.s9-time-card:hover {
    transform: translateY(-4px) scale(1.01);
    border-color: rgba(212, 106, 40, 0.5);
    box-shadow: 0 12px 30px rgba(212, 106, 40, 0.12);
}

.s9-time-card-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
}

.s9-time-card-icon svg {
    width: 100%;
    height: 100%;
}

.s9-time-card-content h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #D46A28;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.s9-time-card-content p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    color: #4A5B6D;
    line-height: 1.5;
    margin: 0;
}

.s9-time-card-shimmer {
    position: absolute;
    top: 0; left: -100%;
    width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(217, 164, 65, 0.08), transparent);
    transform: skewX(-20deg);
    animation: s9CardShimmer 6s infinite;
}

@keyframes s9CardShimmer {
    0% { left: -100%; }
    30% { left: 200%; }
    100% { left: 200%; }
}

/* ==============================================================
   GROWTH STEP STAIRCASE — Layered Glass Panel Effect
   ============================================================== */

.s9-steps-staircase {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 0;
}

/* Each step row: the number block overlaps the left edge of the glass card */
.s9-step-row {
    display: flex;
    align-items: stretch;
    position: relative;
    opacity: 0;
    transform: translateX(-40px) scale(0.92);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.s9-opportunity-section.revealed .s9-step-row {
    opacity: 1;
    transform: translateX(0) scale(1);
}

/* Staggered reveal delays */
.s9-opportunity-section.revealed .s9-step-1 { transition-delay: 0.6s; }
.s9-opportunity-section.revealed .s9-step-2 { transition-delay: 0.78s; }
.s9-opportunity-section.revealed .s9-step-3 { transition-delay: 0.96s; }
.s9-opportunity-section.revealed .s9-step-4 { transition-delay: 1.14s; }
.s9-opportunity-section.revealed .s9-step-5 { transition-delay: 1.32s; }

/* Staircase indentation — each step indents to the left creating the pyramid */
.s9-step-1 { margin-left: 40%; }
.s9-step-2 { margin-left: 30%; }
.s9-step-3 { margin-left: 20%; }
.s9-step-4 { margin-left: 10%; }
.s9-step-5 { margin-left: 0%; }

/* Idle float animation */
.s9-step-row {
    animation: s9StepFloat 6s ease-in-out infinite alternate;
    animation-play-state: paused;
}

.s9-opportunity-section.revealed .s9-step-row {
    animation-play-state: running;
}

.s9-step-1 { animation-delay: 0s; }
.s9-step-2 { animation-delay: 0.8s; }
.s9-step-3 { animation-delay: 1.6s; }
.s9-step-4 { animation-delay: 2.4s; }
.s9-step-5 { animation-delay: 3.2s; }

@keyframes s9StepFloat {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-4px) scale(1.005); }
}

/* ---- Step Number Block (overlaps the glass card left edge) ---- */
.s9-step-number-block {
    flex-shrink: 0;
    width: 90px;
    background: var(--step-color, #1B2A4A);
    border-radius: 10px;
    padding: 12px 10px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 3;
    margin-right: -20px; /* overlaps the glass card left edge */
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.s9-step-row:hover .s9-step-number-block {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.3);
}

.s9-step-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    margin-bottom: 0;
}

.s9-step-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #FFF;
    line-height: 1;
    margin-bottom: 6px;
}

/* Progress bar inside number block */
.s9-progress-bar-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 4px;
}

.s9-progress-bar {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
}

.s9-progress-bar::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.9));
    border-radius: 2px;
    transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.s9-opportunity-section.revealed .s9-progress-bar[data-percent="100"]::after { width: 100%; transition-delay: 1.5s; }
.s9-opportunity-section.revealed .s9-progress-bar[data-percent="75"]::after { width: 75%; transition-delay: 1.7s; }
.s9-opportunity-section.revealed .s9-progress-bar[data-percent="50"]::after { width: 50%; transition-delay: 1.9s; }
.s9-opportunity-section.revealed .s9-progress-bar[data-percent="30"]::after { width: 30%; transition-delay: 2.1s; }
.s9-opportunity-section.revealed .s9-progress-bar[data-percent="10"]::after { width: 10%; transition-delay: 2.3s; }

.s9-progress-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.5rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
}

/* ---- Glass Card (extends to the right) ---- */
.s9-step-glass-card {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px 16px 36px; /* extra left padding for overlap area */
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(217, 164, 65, 0.15);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}

.s9-step-row:hover .s9-step-glass-card {
    transform: translateY(-4px);
    border-color: rgba(212, 106, 40, 0.35);
    box-shadow: 0 16px 40px rgba(212, 106, 40, 0.1), 0 4px 12px rgba(0, 0, 0, 0.05);
}

/* Hover: other steps dim */
.s9-steps-staircase:hover .s9-step-row:not(:hover) {
    opacity: 0.5;
    filter: grayscale(30%);
}

.s9-glass-reflection {
    position: absolute;
    top: 0; left: -100%;
    width: 50%; height: 100%;
    background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transform: skewX(-15deg);
    transition: left 0.6s ease;
    pointer-events: none;
}

.s9-step-row:hover .s9-glass-reflection {
    left: 200%;
}

/* Icon inside glass card */
.s9-step-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: rgba(255, 255, 255, 0.7);
    transition: all 0.4s ease;
}

.s9-step-icon svg {
    width: 100%;
    height: 100%;
}

.s9-step-row:hover .s9-step-icon {
    transform: rotate(8deg) scale(1.08);
    box-shadow: 0 4px 12px rgba(212, 106, 40, 0.15);
}

/* Step content text */
.s9-step-content h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1B2A4A;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
    white-space: nowrap;
}

.s9-step-desc {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    color: #5B6B7D;
    line-height: 1.45;
    margin: 0;
    max-width: 240px;
    transition: opacity 0.3s ease;
}

.s9-step-row:hover .s9-step-desc {
