/* Entrance Animations */
.s10-getstarted-section.revealed .s10-benefit-item:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 1.1s; }
.s10-getstarted-section.revealed .s10-benefit-item:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 1.2s; }
.s10-getstarted-section.revealed .s10-benefit-item:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 1.3s; }
.s10-getstarted-section.revealed .s10-benefit-item:nth-child(4) { opacity: 1; transform: translateY(0); transition-delay: 1.4s; }

/* Spotlight effect on hover (updated via JS) */
.s10-benefit-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(180px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 106, 40, 0.07), transparent 50%);
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
}

/* Liquid Reflection Shine Sweep */
.s10-benefit-item::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.3) 50%,
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    transition: left 0.75s ease;
    pointer-events: none;
    z-index: 2;
}

/* Hover States */
.s10-getstarted-section.revealed .s10-benefit-item:hover {
    transform: translateY(-6px) scale(1.02);
    border-color: rgba(212, 106, 40, 0.35);
    background: rgba(255, 255, 255, 0.65);
    box-shadow: 0 16px 36px rgba(212, 106, 40, 0.08),
                inset 0 1px 2px rgba(255, 255, 255, 0.8);
}

.s10-benefit-item:hover::before {
    opacity: 1;
}

.s10-benefit-item:hover::after {
    left: 150%;
}

/* Icon Wrap inside card */
.s10-benefit-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(212, 106, 40, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 4px 10px rgba(212, 106, 40, 0.04);
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    z-index: 3;
}

.s10-benefit-icon svg {
    width: 100%;
    height: 100%;
}

.s10-benefit-item:hover .s10-benefit-icon {
    border-color: rgba(212, 106, 40, 0.5);
    box-shadow: 0 6px 15px rgba(212, 106, 40, 0.15);
    transform: rotate(6deg) scale(1.08);
    background: #FFF;
}

/* Text elements inside card */
.s10-benefit-text {
    font-family: 'Outfit', sans-serif;
    line-height: 1.4;
    text-align: left;
    position: relative;
    z-index: 3;
}

.s10-benefit-text strong {
    display: block;
    color: #1B2A4A;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 6px;
    transition: color 0.3s ease;
}

.s10-benefit-text span {
    display: block;
    color: #5B6B7D;
    font-size: 0.8rem;
    line-height: 1.45;
}

.s10-benefit-item:hover .s10-benefit-text strong {
    color: #D46A28;
}

/* Discovery Tagline */
.s10-discovery-tagline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    background: rgba(255, 255, 255, 0.45);
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid rgba(217, 164, 65, 0.12);
    width: 100%;
    opacity: 0; transform: translateY(10px);
    transition: all 1s ease 1.6s;
}
.s10-getstarted-section.revealed .s10-discovery-tagline { opacity: 1; transform: translateY(0); }

.s10-discovery-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #D46A28;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    flex-shrink: 0;
}
.s10-discovery-icon svg { width: 18px; height: 18px; }
.s10-discovery-text {
    display: flex;
    flex-direction: column;
    text-align: left;
}
.s10-discovery-text strong {
    font-family: 'Outfit', sans-serif; font-size: 0.72rem; font-weight: 700; color: #1B2A4A; letter-spacing: 0.5px;
}
.s10-discovery-text span {
    font-family: 'Outfit', sans-serif; font-size: 0.72rem; font-weight: 800; color: #D46A28; letter-spacing: 0.5px;
}

/* ---- Café Card ---- */
.s10-cafe-card {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    padding: 0;
    background: linear-gradient(135deg, rgba(217,164,65,0.2) 0%, rgba(217,164,65,0.05) 50%, rgba(217,164,65,0.2) 100%);
    box-shadow: 0 20px 45px rgba(0,0,0,0.08), 0 0 25px rgba(217,164,65,0.03);
    border: 1px solid rgba(217, 164, 65, 0.2);
    overflow: hidden;
    flex-shrink: 0;
    opacity: 0; transform: scale(0.95);
    transition: all 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.6s, border-color 0.4s ease, box-shadow 0.4s ease;
}

.s10-cafe-card:hover {
    border-color: rgba(212, 106, 40, 0.35);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15), 0 0 30px rgba(212, 106, 40, 0.05);
}

.s10-getstarted-section.revealed .s10-cafe-card { opacity: 1; transform: scale(1); }

.s10-cafe-image-container {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    z-index: 1;
}

.s10-cafe-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s ease;
}
.s10-cafe-card:hover .s10-cafe-img {
    transform: scale(1.05);
}

.s10-cafe-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(27, 42, 74, 0.3) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
}
.s10-cafe-vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(27, 42, 74, 0.2) 100%);
    pointer-events: none;
    z-index: 2;
}
.s10-cafe-warm-light {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 10%, rgba(217,164,65,0.15) 0%, transparent 75%);
    pointer-events: none;
    z-index: 2;
}
.s10-cafe-glow-line {
    position: absolute;
    bottom: -15px;
    right: -15px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1.5px solid rgba(217, 164, 65, 0.4);
    filter: blur(4px) drop-shadow(0 0 10px rgba(217, 164, 65, 0.2));
    pointer-events: none;
    z-index: 2;
}

/* ==============================================================
   ACTION CARDS (RIGHT COLUMN)
   ============================================================== */
.s10-cards-col {
    display: flex; gap: 24px;
    align-items: stretch;
    justify-content: flex-end;
}

.s10-action-card {
    width: 245px;
    background: rgba(255,255,255,0.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 36px 20px 24px; position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    opacity: 0; transform: translateY(40px) scale(0.94);
    transition: all 0.8s cubic-bezier(0.22,1,0.36,1);
}
.s10-getstarted-section.revealed .s10-action-card[data-card="1"] { opacity: 1; transform: translateY(0) scale(1); transition-delay: 0.7s; }
.s10-getstarted-section.revealed .s10-action-card[data-card="2"] { opacity: 1; transform: translateY(0) scale(1); transition-delay: 0.9s; }
.s10-getstarted-section.revealed .s10-action-card[data-card="3"] { opacity: 1; transform: translateY(0) scale(1); transition-delay: 1.1s; }

.s10-card-gold {
    border: 1px solid rgba(217,164,65,0.18);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04), 0 0 15px rgba(217, 164, 65, 0.04);
}
.s10-card-navy {
    border: 1px solid rgba(27, 42, 74, 0.12);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04), 0 0 15px rgba(27, 42, 74, 0.02);
}

/* Card Hover States */
.s10-card-gold:hover {
    border-color: rgba(212,106,40,0.4);
    box-shadow: 0 20px 50px rgba(212,106,40,0.12), 0 0 25px rgba(212,106,40,0.08);
}
.s10-card-navy:hover {
    border-color: rgba(27, 42, 74, 0.35);
    box-shadow: 0 20px 50px rgba(27, 42, 74, 0.12), 0 0 25px rgba(27, 42, 74, 0.08);
}
.s10-cards-col:hover .s10-action-card:not(:hover) { opacity: 0.55; filter: grayscale(15%); }

/* Card Ribbon Badges */
.s10-card-badge {
    position: absolute; top: 0; left: 24px;
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Outfit', sans-serif; font-size: 0.92rem; font-weight: 800;
    color: #FFF; border-radius: 0 0 6px 6px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    z-index: 5;
}
.s10-badge-orange { background: #D46A28; }
.s10-badge-navy { background: #1B2A4A; }

/* Large circle icon badges */
.s10-circle-badge {
    width: 80px; height: 80px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px; margin-top: 10px;
    position: relative;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(217, 164, 65, 0.15);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
}
.s10-circle-badge svg { width: 34px; height: 34px; }

.s10-gold-glow {
    box-shadow: 0 0 20px rgba(212, 106, 40, 0.08), 0 0 0 4px rgba(212, 106, 40, 0.03);
    border-color: rgba(212, 106, 40, 0.18);
}
.s10-navy-glow {
    box-shadow: 0 0 20px rgba(27, 42, 74, 0.08), 0 0 0 4px rgba(27, 42, 74, 0.03);
    border-color: rgba(27, 42, 74, 0.18);
}
.s10-action-card:hover .s10-circle-badge {
    transform: scale(1.08);
}
.s10-action-card:hover .s10-gold-glow {
    box-shadow: 0 0 25px rgba(212, 106, 40, 0.2), 0 0 0 6px rgba(212, 106, 40, 0.05);
}
.s10-action-card:hover .s10-navy-glow {
    box-shadow: 0 0 25px rgba(27, 42, 74, 0.2), 0 0 0 6px rgba(27, 42, 74, 0.05);
}

/* Card Body wrapper */
.s10-card-body {
    display: contents;
}

/* Card Title */
.s10-card-title {
    font-family: 'Outfit', sans-serif; font-size: 0.92rem; font-weight: 800;
    color: #1B2A4A; letter-spacing: 1.5px; text-transform: uppercase;
    line-height: 1.35; margin-bottom: 0;
}

/* Card Divider Lines */
.s10-card-divider {
    width: 32px; height: 2px;
    margin: 12px 0 16px;
    border-radius: 2px;
}
.s10-div-orange { background: #D46A28; }
.s10-div-navy { background: #1B2A4A; }

/* Card Description */
.s10-card-desc {
    font-family: 'Outfit', sans-serif; font-size: 0.76rem; color: #5B6B7D;
    line-height: 1.5; margin-bottom: 20px; flex-grow: 1;
}

/* Card Action wrapper */
.s10-card-action-wrap {
    display: contents;
}

/* Card Buttons */
.s10-card-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 12px 20px; border-radius: 8px;
    font-family: 'Outfit', sans-serif; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 1.5px; text-decoration: none; text-transform: uppercase;
    position: relative; overflow: hidden;
    transition: all 0.4s cubic-bezier(0.22,1,0.36,1); margin-bottom: 18px;
}
.s10-card-btn svg { width: 14px; height: 14px; transition: transform 0.3s ease; }

.s10-btn-filled-orange {
    background: #D46A28; color: #FFF;
    box-shadow: 0 4px 12px rgba(212,106,40,0.22);
}
.s10-btn-filled-orange:hover {
    background: #c35c1d; box-shadow: 0 6px 18px rgba(212,106,40,0.35);
    transform: translateY(-2px);
}
.s10-btn-filled-orange:hover svg { transform: translateY(2px); }

.s10-btn-filled-navy {
    background: #1B2A4A; color: #FFF;
    box-shadow: 0 4px 12px rgba(27,42,74,0.22);
}
.s10-btn-filled-navy:hover {
    background: #121d33; box-shadow: 0 6px 18px rgba(27,42,74,0.35);
    transform: translateY(-2px);
}
.s10-btn-filled-navy:hover svg { transform: translateX(3px); }

.s10-btn-shimmer {
    position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: skewX(-20deg); animation: s10ShimmerLoop 4s infinite;
}
@keyframes s10ShimmerLoop { 0% { left: -100%; } 30% { left: 200%; } 100% { left: 200%; } }

/* Card Footer */
.s10-card-footer {
    display: flex; align-items: flex-start; gap: 8px;
    padding-top: 14px; border-top: 1px solid rgba(217,164,65,0.12);
    text-align: left; width: 100%;
}
.s10-card-footer svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 1px; }
.s10-card-footer span {
    font-family: 'Outfit', sans-serif; font-size: 0.66rem; color: #6B7B8D; line-height: 1.4;
}

/* Card Reflection */
.s10-card-reflection {
    position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(110deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: skewX(-15deg); transition: left 0.6s ease; pointer-events: none;
}
.s10-action-card:hover .s10-card-reflection { left: 200%; }

/* Idle float */
.s10-action-card { animation: s10CardFloat 7s ease-in-out infinite alternate; animation-play-state: paused; }
.s10-getstarted-section.revealed .s10-action-card { animation-play-state: running; }
.s10-action-card[data-card="1"] { animation-delay: 0s; }
.s10-action-card[data-card="2"] { animation-delay: 1.5s; }
