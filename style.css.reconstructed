}

@keyframes s8BtnShimmerLoop {
    0% { left: -100%; }
    20% { left: 200%; }
    100% { left: 200%; }
}

.s8-btn-gold:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(212, 106, 40, 0.5);
